/* Barra dello scostamento: la linea dell'obiettivo sta sempre al centro, uguale in ogni riga.
   La barra parte da lì — a sinistra se si spende meno (risparmio), a destra se si spende di più.
   Si legge una riga sola: da che parte sto, e di quanto. */
function gaugeHTML(name, subtitle, pct, euro, target, steps, maxExtra, ricavi){
  if(!isFinite(pct)) return '';
  const p=pct*100, z=zone(pct,target,steps);
  const span=maxExtra;                          // punti percentuali visibili per lato
  const dpp=p-target;                           // scostamento in punti percentuali
  const half=Math.max(-1,Math.min(1,dpp/span))*50;
  const scost=(pct-target/100)*ricavi;
  const oltre=Math.abs(dpp)>span;               // fuori scala: la barra arriva a fondo e lo diciamo
  const col=['var(--ok)','var(--warn)','var(--hot)','var(--bad)'][z];
  const inLinea=Math.abs(dpp)<0.05;   // praticamente sull'obiettivo
  const dppTxt= inLinea ? 'in linea' : (dpp>=0?'+':'−')+fmtNum(Math.abs(dpp))+' p.p.';
  const xVal=50+half;                       // posizione del dato sulla barra
  return `<div class="strip">
    <div class="head">
      <div class="name">${name}<b class="pc">${fmtP(pct)}</b><span class="verdict ${ZC[z]}">${ZN[z]}</span></div>
      <div class="reading"><span class="money">${fmtE(euro)}${inLinea?'':` · ${scost>0?`extracosto <b style="color:var(--bad)">${fmtE(scost)}</b>`:`risparmio <b style="color:var(--ok)">${fmtE(-scost)}</b>`}`}</span></div>
    </div>
    <div class="devbar">
      <div class="zones">
        <div class="z-ok"></div>
        <div class="z-warn" style="width:${(steps[0]/span*50).toFixed(2)}%"></div>
        <div class="z-hot" style="width:${((steps[1]-steps[0])/span*50).toFixed(2)}%"></div>
        <div class="z-bad"></div>
      </div>
      <div class="fill verde" style="width:${Math.min(xVal,50).toFixed(2)}%"></div>
      ${dpp>0?`<div class="fill extra${oltre?' oltre':''}" style="left:50%;width:${half.toFixed(2)}%;background:${col}"></div>`:''}
      <div class="obj"><span class="pill">${fmtNum(target)}%</span></div>
      <div class="val ${dpp>=0?'dx':'sx'}${Math.abs(half)>38?' dentro':''}" style="left:${xVal.toFixed(2)}%;color:${dpp>0?col:'var(--ok)'}">${dppTxt}</div>
    </div>
  </div>`;
}

