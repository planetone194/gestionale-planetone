  ].filter(x=>isFinite(x.e)).sort((x,y)=>y.e-x.e);
  const roS=a.ricavi*(1-(t.ru+t.mp+t.sg)/100);
  return {m,a,t,dev,roS,rows,isM};
}
function anExec(d){
  const {a,t,dev,roS,rows,isM}=d;
  const first=rows[0], last=rows[rows.length-1];
  const trend=first&&last&&first!==last?(last.ricavi-first.ricavi)/first.ricavi:null;
  const out=[];
  out.push(isM
    ? `Nel mese di ${first.mese} i ricavi sono stati ${fmtE(a.ricavi)}.`
    : `Ricavi di ${fmtE(a.ricavi)} in ${rows.length} mesi (media ${fmtE(a.ricavi/rows.length)}/mese)${trend!=null?`, con ${last.mese} a ${trend>=0?'+':''}${fmtP(trend)} su ${first.mese}`:''}.`);
  out.push(`Reddito operativo ${a.ro<0?'negativo per':'di'} ${fmtE(Math.abs(a.ro))} (${fmtP(a.ro/a.ricavi)} sui ricavi), contro un obiettivo del ${t.ro}%.`);
  if(dev[0]&&dev[0].e>0) out.push(`Criticità principale: ${dev[0].n.toLowerCase()} al ${fmtP(dev[0].inc)} contro un target del ${dev[0].t}%, per un extracosto di ${fmtE(dev[0].e)}.`);
  if(a.cn>0) out.push(`L'Interceptor ha individuato ${fmtE(a.cn)} di costi nascosti (${fmtP(a.incCn)} del venduto, soglia ${t.cn}%).`);
  out.push(`Riportando le incidenze in obiettivo il reddito operativo salirebbe a ${fmtE(roS)} (${fmtP(roS/a.ricavi)}): un recupero di ${fmtE(roS-a.ro)}.`);
  return out;
}
function anActions(d){
  const {m,a,t,dev}=d;
  const _rows=d.rows;
  const az=[];
  if(a.incRu*100>t.ru) az.push({t:'Risorse umane: riallineare organico e turni',x:`Incidenza al ${fmtP(a.incRu)} (target ${t.ru}%): extracosto di ${fmtE((a.incRu-t.ru/100)*a.ricavi)}. Rivedere la pianificazione turni sui flussi reali di incasso, valutare la copertura nelle fasce a bassa produttività e verificare la corretta imputazione delle figure condivise.`});
  if(a.ricaviFood>0&&a.mpFood/a.ricaviFood>t.mp/100) az.push({t:'Food cost: intervento su acquisti e distinte',x:`La materia prima Food incide per ${fmtP(a.mpFood/a.ricaviFood)} sui ricavi Food. Rinegoziare i listini fornitori, aggiornare le distinte base con grammature reali, introdurre inventari di reparto e applicare il menu engineering per spingere i piatti ad alto margine.`});
  if(a.ricaviBev>0&&a.mpBev/a.ricaviBev>t.mp/100) az.push({t:'Beverage cost: controllo dosi e carta',x:`La materia prima Beverage incide per ${fmtP(a.mpBev/a.ricaviBev)} sui ricavi Beverage. Standardizzare le dosi (jigger/contadosi), monitorare gli sfridi e rivedere il pricing della drink list sui prodotti focus.`});
  if(a.incSg*100>t.sg){
    const gr={}; S.sg.forEach(c=>{ gr[c.gruppo]=(gr[c.gruppo]||0)+c.m.reduce((x,v)=>x+num(v),0); });
    const top=Object.entries(gr).sort((x,y)=>y[1]-x[1]).slice(0,2).map(([g,v])=>`${g} (${fmtE(v)})`).join(' e ');
    az.push({t:'Spese generali: rinegoziazione mirata',x:`Incidenza al ${fmtP(a.incSg)} (target ${t.sg}%). I gruppi più pesanti sono ${top}: partire da qui con rinegoziazioni contrattuali, revisione utenze e verifica dei servizi ricorrenti.`});
  }
  if(a.incCn*100>t.cn||a.cn>0) az.push({t:'Costi nascosti: procedure e registrazione',x:`${fmtE(a.cn)} intercettati tra autoconsumi, omaggi, rimanenze e dispersioni. Introdurre la registrazione sistematica di autoconsumi e omaggi, gestire le rimanenze a fine vita e fissare la soglia massima al ${t.cn}% del venduto.`});
  if(m.orphan.length) az.push({t:'Qualità del dato: allineare la competenza',x:`${m.orphan.map(o=>o.mese).join(', ')} presenta costi senza ricavi: allineare la competenza mensile di costi e ricavi per rendere attendibili incidenze e confronti.`});
  if(!az.length) az.push({t:'Mantenimento e presidio',x:'Le incidenze sono in obiettivo: presidiare i target con il monitoraggio mensile e consolidare le procedure in essere.'});
  return az;
}
