  catch(e){ // un tentativo di recupero su errore di rete
    await new Promise(x=>setTimeout(x,900));
    try{ r=await doFetch(); }
    catch(e2){ throw new Error('rete AI non raggiungibile: le funzioni AI richiedono l\'app aperta dentro Claude'); }
  }
