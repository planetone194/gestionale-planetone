  if(mi<0||mi>11){ toast('Mese non indicato: % non salvata.', true); return; }
  const pct=+(f/(f+b)*100).toFixed(1);
  S.salesSplit[mi]=pct;
  // applica subito ai ricavi del mese, se caricati
  const ce=S.ce[mi]; const rt=num(ce.rf)+num(ce.rb); let applied=false;
  if(rt>0){ ce.rf=+(rt*pct/100).toFixed(2); ce.rb=+(rt*(1-pct/100)).toFixed(2); applied=true; }
  saveState();
  const pnl=document.getElementById('splitPanel'); if(pnl && pnl.hidden===false) renderSplitGrid();
  renderCE(); renderDash();
  const unkList=Object.entries(unk).sort((x,y)=>y[1]-x[1]).slice(0,5);
  const unkTot=Object.values(unk).reduce((a,v)=>a+v,0);
  let m=`${MESI[mi]}: Food ${fmtP(pct/100)} (${fmtE(f)}) · Beverage ${fmtP(1-pct/100)} (${fmtE(b)}).`;
  if(applied) m+=' Applicata ai ricavi del mese.'; else m+=' Salvata: verrà applicata quando carichi i ricavi del mese.';
  if(unkTot>0) m+=` Non classificati ${fmtE(unkTot)}: ${unkList.map(([k,v])=>k+' ('+fmtE(v)+')').join(', ')} — dimmi dove vanno e aggiungo le parole chiave.`;
  if(msgEl) msgEl.textContent='✓ '+m;
  toast('✓ Venduto letto: '+MESI[mi]+' → '+fmtP(pct/100)+' Food.');
}
async function vendutoFromFile(file){
  const msgEl=document.getElementById('vendutoMsg'); if(msgEl) msgEl.textContent='Lettura del venduto…';
  try{
    const items=[];
    if(/\.pdf$/i.test(file.name)||file.type==='application/pdf'){
      const lines=await pdfToLines(await file.arrayBuffer());
      lines.forEach(ln=>{ const lm=lineLabelNums(ln); if(lm&&lm.nums.length) items.push({label:lm.label, val:lm.nums[lm.nums.length-1]}); });
    } else {
      const wb=XLSX.read(await file.arrayBuffer(),{type:'array'});
      for(const n of wb.SheetNames){
        const g=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:null});
        // colonna importo: header incass/importo/totale/valore, altrimenti ultimo numero della riga
        let valCol=-1;
        for(let r=0;r<Math.min(g.length,10);r++){
          (g[r]||[]).forEach((v,c)=>{ if(valCol<0 && /incass|importo|totale|valore|netto|lordo|venduto/.test(norm(v))) valCol=c; });
          if(valCol>=0) break;
        }
        g.forEach(row=>{
          if(!row) return;
          const label=row.find(v=>typeof v==='string'&&v.trim());
          if(!label) return;
          let val=null;
          if(valCol>=0 && typeof row[valCol]==='number') val=row[valCol];
          if(val==null){ for(let c=row.length-1;c>=0;c--){ if(typeof row[c]==='number'&&isFinite(row[c])){ val=row[c]; break; } } }
          if(val!=null) items.push({label, val:num(val)});
        });
        if(items.length>3) break;
      }
    }
    await finishVenduto(items, file.name);
  }catch(e){ const t='Impossibile leggere il venduto: '+e.message; if(msgEl) msgEl.textContent='⚠️ '+t; toast(t,true); }
