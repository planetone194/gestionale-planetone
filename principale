  const active=document.activeElement, ds=active?{...active.dataset}:null, val=active?active.value:null, pos=active&&active.selectionStart;
  PAGES[page]();
  if(scroller){ document.querySelector(`#page-${page} .tblwrap`).scrollLeft=sx; }
