const TPL_MK='↳ Merchandising';
function tplRU(){
  const rows=[
    ['TEMPLATE PLANET ONE · RISORSE UMANE — '+(S.cliente||'cliente')+' '+S.anno],
    ['Ogni persona ha DUE righe: la prima è il costo lordo azienda del mese (esclusa TFR), la seconda — con "'+TPL_MK+'" nella colonna Ruolo e il nome lasciato vuoto — è la parte merchandising (mance, extra, benefit).'],
    ['Le righe in maiuscolo sono i reparti: lasciale vuote e non rinominarle. Per aggiungere una persona, copia una coppia di righe e scrivici sopra.'],
    [],
