function renderAll(){ renderMerchSw(); PAGES[current](); if(current!=='dash') renderDash(); }
/* interruttore merchandising in testata */
function renderMerchSw(){
  const sw=document.getElementById('merchSw'); if(!sw) return;
  const M=merchMode(), attivo=hasMerchData();
  sw.querySelectorAll('button').forEach(b=>b.classList.toggle('on', b.dataset.merch===M));
  sw.classList.toggle('off', !attivo && M==='incl');
  sw.title = attivo
    ? 'Merchandising: '+(M==='incl'?'incluso nei conti':M==='escl'?'escluso dai conti':'visualizzato da solo')
    : 'Nessun dato di merchandising caricato: le voci sono nel Conto economico e nelle Spese generali';
}
function setMerchMode(m){
  if(!S.merch) S.merch={mode:'incl'};
  if(S.merch.mode===m) return;
  S.merch.mode=m;
  renderMerchSw(); renderAll(); saveState();
  toast(m==='incl'?'Merchandising incluso: i conti comprendono ricavi e spese del merchandising.'
      : m==='escl'?'Merchandising escluso: resti sui numeri della gestione corrente.'
      : 'Merchandising isolato: vedi solo ricavi e spese del merchandising.');
}
