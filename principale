  let mi=monthFromText(fname);
  if(mi<0) mi=monthFromText(lines.slice(0,20).join(' '));
  if(mi<0){
    const ans=await uiPrompt('Il documento sembra riferirsi a un solo mese: quale? (es. Gennaio)','');
    mi=ans?monthIdx(ans):-1;
    if(mi<0) return {ok:false, msg:'mese non indicato: impossibile importare'};
  }
  for(const ln of lines){
    const lm=lineLabelNums(ln); if(!lm) continue;
    const k=classifyCE(lm.label); if(!k||!lm.nums.length) continue;
    seen[k]++;
    acc[k][mi]+=lm.nums[0]; // prima colonna = importo del mese
  }
  const r=applyCE(acc,seen,'PDF');
  if(r.ok) r.msg='mese di '+MESI[mi]+': '+r.msg+' Puoi caricare gli altri bilancini mensili uno dopo l\'altro.';
  else r.msg='nel documento di '+MESI[mi]+' non ho riconosciuto voci di ricavi o materie prime. '+r.msg;
  return r;
}
