/* ---------- venduto: classificazione categorie e calcolo % F&B ---------- */
const BEV_RE=/caff|cappucc|espress|ginseng|orzo|bevand|bibit|drink|cocktail|birr|vin[oi]\b|spumant|prosecc|champagne|amar[oi]\b|liquor|grapp|spirit|aperitiv|spritz|\bgin\b|\brum\b|vodka|whisk|analcolic|succh?|acqua|\bthe\b|tè|tisan|caffetteria|beverage|\bbar\b|soft ?drink|estratt|centrifug|smoothie/;
const FOOD_RE=/cucin|\bfood\b|panin|toast|piadin|tramezz|focacc|pizz|dolc|dessert|croissant|brioch|cornett|pasticc|gelat|insalat|\bprim[oi]\b|\bsecond[oi]\b|antipast|taglier|snack|colazion|brunch|hamburg|burger|fritt|contorn|frutta|torta|biscott|patatin|club|bagel|pancake|pok[eè]|sush|salum|formagg|zupp|past[ae]\b|risott|carn|pesce|griglia/;
function classifySale(l){ l=norm(l); if(!l) return null; if(BEV_RE.test(l)) return 'b'; if(FOOD_RE.test(l)) return 'f'; return null; }
function tallyVenduto(items){ // items: [{label, val}]
  let f=0,b=0; const unk={};
  items.forEach(it=>{
    if(!it.label||!(it.val>0)) return;
    const ln=norm(it.label);
    if(/^total|^riepilog|^periodo|iva\b/.test(ln)) return;
    const c=classifySale(it.label);
    if(c==='f') f+=it.val; else if(c==='b') b+=it.val;
    else unk[it.label]=(unk[it.label]||0)+it.val;
  });
  return {f,b,unk};
}
async function finishVenduto(items, srcName){
  const {f,b,unk}=tallyVenduto(items);
  const msgEl=document.getElementById('vendutoMsg');
  if(f+b<=0){ const t='Nessuna categoria Food/Beverage riconosciuta nel venduto.'; if(msgEl) msgEl.textContent='⚠️ '+t; toast(t,true); return; }
  let mi=monthFromText(srcName);
