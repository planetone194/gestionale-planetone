    const key=Object.keys(ds)[0];
    if(key){ const sel=`[data-${key.replace(/[A-Z]/g,m=>'-'+m.toLowerCase())}="${ds[key]}"]`;
      const nel=document.querySelector(sel);
      if(nel){ if(val!=null && nel.value!==val) nel.value=val;  // mantiene quello che si sta digitando
               refocusing=true;
               nel.focus(); try{nel.setSelectionRange(pos,pos);}catch(e){}
               refocusing=false; } }
  }
}

