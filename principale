async function delClientFlow(targetId){
  const id = targetId || CLIENTS.activeId;
  if(CLIENTS.list.length<=1){ toast('È l\'unico cliente in archivio: creane un altro prima di eliminarlo.', true); return; }
  const c=CLIENTS.list.find(x=>x.id===id);
  const nome=c?c.nome:'cliente';
  const okDel=await uiConfirm('Sei sicuro di eliminare il cliente "'+nome+'"? Perderai tutti i dati al suo interno: conto economico, personale, spese e obiettivi. L\'operazione non è reversibile.');
