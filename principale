/* ================================================================
   IMPORT EXCEL (bilancio Planet One)
================================================================ */
function colLetter(n){ let s=''; n++; while(n>0){ const m=(n-1)%26; s=String.fromCharCode(65+m)+s; n=Math.floor((n-1)/26);} return s; }
function cellv(ws,c,r){ const x=ws[c+r]; return x?x.v:null; }
async function importPlanetOne(wb, fname){
    const names=wb.SheetNames;
    const sName=names.find(n=>norm(n).includes('sintesi bilanci')&&!norm(n).includes('full'));
    const rName=names.find(n=>norm(n).includes('riepilogo'));
    if(!sName) throw new Error('foglio "0. SINTESI BILANCI" non trovato.');
    const ws=wb.Sheets[sName];
    const y=sName.match(/20\d\d/); if(y) S.anno=y[0];
    // colonne da header riga 5
    const range=XLSX.utils.decode_range(ws['!ref']); const cols={};
    for(let c=range.s.c;c<=Math.min(range.e.c,80);c++){
      const h=norm(cellv(ws,colLetter(c),5)); if(!h) continue;
      if(h==='totale ricavi'&&!cols.ricavi) cols.ricavi=colLetter(c);
      if(h.startsWith('totale risorse umane')&&!cols.ru) cols.ru=colLetter(c);
      if(h.startsWith('totale materie prima')&&!cols.mp) cols.mp=colLetter(c);
      if(h==='costi indiretti'&&!cols.sg) cols.sg=colLetter(c);
      if(h.startsWith('autoconsumo')&&!cols.ac) cols.ac=colLetter(c);
      if(h.startsWith('mktg omaggi')&&!cols.om) cols.om=colLetter(c);
      if(h.startsWith('rimanenze prodotti')&&!cols.ri) cols.ri=colLetter(c);
      if(h.startsWith('ghost cost')&&!cols.gh) cols.gh=colLetter(c);
    }
    // ratio food/bev dal riepilogo
    let ratioR=.5, ratioMP=.5, ruF=.5;
    if(rName){
      const w2=wb.Sheets[rName]; const g={};
      for(let r=1;r<=60;r++){
        const a=norm(cellv(w2,'A',r)); if(!a) continue;
        const I=num(cellv(w2,'I',r));
        if(a.startsWith('food - ricavi')) g.rf=I;
        else if(a.startsWith('beverage ricavi')) g.rb=I;
        else if(a.startsWith('materie prime food')) g.mf=I;
        else if(a.startsWith('materie prime beverage')) g.mb=I;
        else if(a.startsWith('risorse umane food')) g.ruf=I;
        else if(a.startsWith('risorse umane beverage')) g.rub=I;
      }
      if(g.rf+g.rb>0) ratioR=g.rf/(g.rf+g.rb);
      if(g.mf+g.mb>0) ratioMP=g.mf/(g.mf+g.mb);
      if(g.ruf+g.rub>0) ruF=g.ruf/(g.ruf+g.rub);
    }
    // righe mesi
    const rows={};
    for(let r=6;r<=40;r++){ const a=String(cellv(ws,'A',r)||'').trim(); if(MESI.includes(a)) rows[a]=r; }
    const ruM=zeros(), acM=zeros(), omM=zeros(), riM=zeros(), ghM=zeros();
    MESI.forEach((mese,i)=>{
      const r=rows[mese]; if(!r) return;
      const g=c=>cols[c]?num(cellv(ws,cols[c],r)):0;
      const ric=g('ricavi'), mp=g('mp');
      const rRi=monthSplitR(i,ratioR), mRi=monthSplitR(i,ratioMP);
      ceSet(i,{ rf:+(ric*rRi).toFixed(2), rb:+(ric*(1-rRi)).toFixed(2), ra:0,
                mf:+(mp*mRi).toFixed(2), mb:+(mp*(1-mRi)).toFixed(2) });
      ruM[i]=g('ru');
      acM[i]=g('ac'); omM[i]=g('om'); riM[i]=g('ri'); ghM[i]=g('gh');
    });
    // RU: persona per persona dal foglio "6. Costo RISORSE UMANE" (colonne mensili F..Q)
    const ruSheetName = names.find(n=>norm(n).includes('risorse umane') && n.includes(String(S.anno)) && !n.includes('(2)'))
                     || names.find(n=>norm(n).includes('risorse umane') && !n.includes('(2)'));
    let ruDetail=false;
    if(ruSheetName){
      const w6=wb.Sheets[ruSheetName];
      const people=[]; let rep=null;
      for(let r=1;r<=140;r++){
        const raw=cellv(w6,'B',r); if(raw==null) continue;
        const t=String(raw).trim(), tn=norm(t);
        if(tn.includes('ripartizione per incidenze') && (tn.startsWith('food')||tn.startsWith('beverage'))) break; // sezioni calcolate: stop
        if(tn.includes('risorse umane indirette')){ rep='Management'; continue; }
        if(tn==='cucina'){ rep='Cucina'; continue; }
        if(tn==='bar'){ rep='Bar'; continue; }
        if(tn==='sala'){ rep='Sala'; continue; }
        if(tn.includes('altri ricavi')){ rep=null; continue; }
        if(!rep) continue;
        if(/^[.\s0]+$/.test(t)) continue; // segnaposto ".." e righe vuote
        if(/^(totale|tot |personale|incentivi|da contabilit|differenza|riprova)/.test(tn)) continue;
        const mv=[]; let any=false;
        for(let c=0;c<12;c++){ const v=num(cellv(w6, colLetter(5+c), r)); mv.push(+v.toFixed(2)); if(v) any=true; }
        if(!any) continue;
        let nome=t, ruolo='';
        const pm=t.match(/^(.*?)\s+(\d{1,3}\s?%)$/); if(pm){ nome=pm[1]; ruolo=pm[2]; } // "Franco Bongiamino 51%" → ruolo 51%
        people.push({id:newId(), reparto:rep, nome, ruolo, m:mv});
      }
      if(people.length){ S.ru=people; ruDetail=true; }
    }
    if(!ruDetail){
      // fallback: due righe aggregate ripartite col ratio del riepilogo
      S.ru=[
        {id:newId(),reparto:'Cucina',nome:'Staff Food (da bilancio)',ruolo:'importato',m:ruM.map(v=>+(v*ruF).toFixed(2))},
        {id:newId(),reparto:'Bar',nome:'Staff Beverage (da bilancio)',ruolo:'importato',m:ruM.map(v=>+(v*(1-ruF)).toFixed(2))}
      ];
    }
    // SG: voce per voce dal foglio "7. COSTI INDIRETTI" (colonne mensili M,S,Y,…)
    const sgSheetName = names.find(n=>norm(n).includes('costi indiretti') && n.includes(String(S.anno)))
                     || names.find(n=>norm(n).includes('costi indiretti'));
    let sgDetail=false;
    if(sgSheetName){
      const w7=wb.Sheets[sgSheetName];
      const SGM=['M','S','Y','AE','AK','AQ','AW','BC','BI','BO','BU','CA'];
      const GROUPS=[['costi gestionali struttura','Costi Gestionali Struttura'],
                    ['consulenze esterne','Consulenze esterne'],
                    ['banche - tasse - imposte','Banche - Tasse - Imposte'],
                    ['altri costi /servizi','Altri costi / Servizi'],
                    ['altri costi / servizi','Altri costi / Servizi'],
                    ['formazione & pubblicità','Formazione & Pubblicità generica'],
                    ['formazione e pubblicità','Formazione & Pubblicità generica']];
      const voci=[]; let curG=null;
      for(let r=4;r<=75;r++){
        const raw=cellv(w7,'A',r); if(raw==null) continue;
        const a=String(raw).trim(), an=norm(a);
        if(an.startsWith('totale costi indiretti')) break;
        const grp=GROUPS.find(([k])=>an.startsWith(k));
        if(grp){ curG=grp[1]; continue; }
        if(!curG || an==='totale' || an.startsWith('totale ')) continue;
        const mv=SGM.map(c=>+(num(cellv(w7,c,r))).toFixed(2));
        voci.push({id:newId(), gruppo:curG, nome:a.replace(/\s+/g,' '), m:mv});
      }
      if(voci.length>=5){ S.sg=voci; sgDetail=true; }
    }
    if(!sgDetail){
      // fallback: totale mensile dalla sintesi come voce aggregata
      S.sg=[{id:newId(),gruppo:'Costi Gestionali Struttura',nome:'Spese generali (da bilancio, totale)',m:zeros()}].concat(
        SG_DEFAULT.map(([g,n])=>({id:newId(),gruppo:g,nome:n,m:zeros()})));
      MESI.forEach((mese,i)=>{ const r=rows[mese]; if(r&&cols.sg) S.sg[0].m[i]=num(cellv(ws,cols.sg,r)); });
    }
    // nascosti
    S.cn[0].m=acM; S.cn[1].m=omM; S.cn[2].m=riM; S.cn[3].m=ghM;
    S.cliente=String(fname||'').replace(/\.(xlsx|xlsm)$/i,'').replace(/BILANCI[O]?[_\s]*/i,'').replace(/_/g,' ').trim()||S.cliente;
    scope='ytd';
    renderAll(); saveState();
    document.getElementById('alerts').insertAdjacentHTML('afterbegin',
      `<div class="alert info"><span>ℹ️</span><div><b>Bilancio importato.</b> Ricavi e materia prima sono stati divisi Food/Beverage con le proporzioni del Riepilogo; personale e spese generali sono caricati come voci aggregate — puoi dettagliarli nelle rispettive pagine.</div></div>`);
}

/* ---------- import conto economico (Planet One o generico) ---------- */
function monthIdx(v){
  if(typeof v==='number' && v>40000 && v<60000){ // data Excel (seriale)
    const d=new Date(Math.round((v-25569)*86400*1000));
    return d.getUTCMonth();
  }
  if(v instanceof Date) return v.getMonth();
  const s=norm(v); if(!s) return -1;
  const full=MESI.findIndex(M=>norm(M)===s); if(full>=0) return full;
  if(s.length>=3) return MESI.findIndex(M=>norm(M).slice(0,3)===s.slice(0,3) && ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'].includes(s.slice(0,3)));
  return -1;
}
/* ================================================================
   TEMPLATE EXCEL · un file da compilare per ogni sezione
   Sono costruiti con le stesse etichette che l'app sa rileggere:
   compilato e ricaricato, il file entra senza ritocchi.
================================================================ */
function tplSave(rows, nomeFoglio, nomeFile, larghezze){
  if(typeof XLSX==='undefined'){ toast('La libreria Excel non è disponibile: controlla la connessione e ricarica la pagina.', true); return; }
  const ws=XLSX.utils.aoa_to_sheet(rows);
  ws['!cols']=larghezze.map(w=>({wch:w}));
  const wb=XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, nomeFoglio);
  XLSX.writeFile(wb, nomeFile);
  toast('✓ Template scaricato: '+nomeFile+'. Compila le celle dei mesi e ricaricalo con "Carica".');
}
