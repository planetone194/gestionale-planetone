/* ---------------- modello di calcolo ---------------- */
/* Cucina→Food, Bar→Beverage; Sala e Management ripartiti per incidenza dei ricavi del mese (metodo Planet One) */
/* ---------------- merchandising: acceso · spento · isolato ---------------- */
function merchMode(){ return (S.merch&&S.merch.mode)||'incl'; }
/* sceglie cosa entra nei conti secondo l'interruttore */
function mPick(core, mer, mode){
  const M=mode||merchMode();
  return M==='escl' ? core : M==='solo' ? mer : core+mer;
}
function hasMerchData(){
  const ce=(S.ce||[]).some(r=>num(r.rfm)||num(r.rbm)||num(r.mfm)||num(r.mbm));
  const sg=(S.sg||[]).some(c=>isMerchSG(c)&&c.m.some(v=>num(v)));
  const ru=(S.ru||[]).some(p=>Array.isArray(p.mk)&&p.mk.some(v=>num(v)));
  return ce||sg||ru;
}
function compute(){
  const M = merchMode();
  const months = MESI.map((mese,i)=>{
    const ce=S.ce[i];
    /* ricavi e materia prima: parte corrente e parte merchandising */
    const rfC=num(ce.rf), rbC=num(ce.rb), raC=num(ce.ra);
    const rfM=num(ce.rfm), rbM=num(ce.rbm);
    const mfC=num(ce.mf), mbC=num(ce.mb), mfM=num(ce.mfm), mbM=num(ce.mbm);
    const rf=mPick(rfC,rfM,M), rb=mPick(rbC,rbM,M), ra=mPick(raC,0,M);
    const mf=mPick(mfC,mfM,M), mb=mPick(mbC,mbM,M);
    const ricavi = rf+rb+ra;
    const mp = mf+mb;
    const shareF = (rf+rb)>0 ? rf/(rf+rb) : .5;
    /* personale: la riga Merchandising della persona è la parte merchandising */
    let ru=0, ruF=0, mkr=0;
    S.ru.forEach(p=>{
      const mkv=(p.mk?num(p.mk[i]):0);
      const v=mPick(num(p.m[i]), mkv, M); ru+=v; mkr+=mkv;
      ruF += v * (p.reparto==='Cucina' ? 1 : p.reparto==='Bar' ? 0 : shareF);
    });
    /* spese generali: il gruppo "Spese Merchandising" è la parte merchandising */
    let sgC=0, sgM=0;
    S.sg.forEach(c=>{ const v=num(c.m[i]); if(isMerchSG(c)) sgM+=v; else sgC+=v; });
    const sg = mPick(sgC, sgM, M);
    const sgShareF = (S.sgSplit&&S.sgSplit.mode==='fissa') ? Math.min(Math.max(num(S.sgSplit.foodPct),0),100)/100 : shareF;
    const sgF = sg*sgShareF;
    const cn = mPick(S.cn.reduce((a,c)=>a+num(c.m[i]),0), 0, M);
    const totCosti = ru+mp+sg;
    /* le due letture sempre disponibili, qualunque sia l'interruttore */
    const ruMk=S.ru.reduce((a,p)=>a+(p.mk?num(p.mk[i]):0),0);
    const ricaviCore=rfC+rbC+raC, ricaviMerch=rfM+rbM;
    const costiCore=mfC+mbC+sgC+S.ru.reduce((a,p)=>a+num(p.m[i]),0);
    const costiMerch=mfM+mbM+sgM+ruMk;
    return { mese, i, ...ce, rf, rb, ra, mf, mb, ricavi, mp, ru, ruF, ruB:ru-ruF, mkr, sg, sgF, sgB:sg-sgF, cn, totCosti, ro:ricavi-totCosti,
             ricaviCore, ricaviMerch, costiCore, costiMerch };
  });
  const complete = months.filter(m=>m.ricavi>0);
  const orphan = months.filter(m=>m.ricavi===0 && (m.ru>0||m.mp>0||m.sg>0));
  const Sm = k => complete.reduce((a,m)=>a+m[k],0);
  const ricavi=Sm('ricavi'), ru=Sm('ru'), mp=Sm('mp'), sg=Sm('sg'), cn=Sm('cn');
  const ricaviFood=Sm('rf'), ricaviBev=Sm('rb'), mpFood=Sm('mf'), mpBev=Sm('mb');
  const ruFood=Sm('ruF'), ruBev=Sm('ruB');
  const orphanCosts = orphan.reduce((a,m)=>a+m.totCosti,0);
  const ro = ricavi-ru-mp-sg-orphanCosts;
  const t = S.targets;
  const roSaving = ricavi*(t.ro/100);
  return { months, complete, orphan, ricavi, ru, mp, sg, cn, ro, orphanCosts,
    ricaviFood, ricaviBev, mpFood, mpBev, ruFood, ruBev,
    merchMode:M, merchData:hasMerchData(),
    ricaviCore:Sm('ricaviCore'), ricaviMerch:Sm('ricaviMerch'),
    costiCore:Sm('costiCore'), costiMerch:Sm('costiMerch'),
    incRu:ru/ricavi, incMp:mp/ricavi, incSg:sg/ricavi, incCn:cn/ricavi,
    roSaving, recupero: roSaving-ro };
}

/* ---------------- semafori ---------------- */
function zone(pct, target, steps){ // steps: [+a,+b] in punti
  const t=target, p=pct*100, [a,b]=steps;
  if(!isFinite(p)) return 0;
  if(p<=t) return 0; if(p<=t+a) return 1; if(p<=t+b) return 2; return 3;
}
const ZN=['In obiettivo','Zona gialla','Zona arancio','Zona rossa'];
const ZC=['v-ok','v-warn','v-hot','v-bad'];

/* ---------------- quadro mese per mese ----------------
   Ogni centro di costo con il suo valore assoluto e, accanto, l'incidenza a semaforo. */
function quadroMese(m, t, isM){
  if(!m.complete.length) return '';
  const pil=(inc,target,steps)=>{
    const z=isFinite(inc)?zone(inc,target,steps||[5,10]):0;
    return `<span class="pil ${ZC[z]}">${fmtP(inc)}</span>`;
  };
  const pilRo=(iro)=>{
    const cl = !isFinite(iro)?'v-ok' : iro<0?'v-bad' : iro*100<num(t.ro)?'v-warn':'v-ok';
    return `<span class="pil ${cl}">${fmtP(iro)}</span>`;
  };
  const cella=(val,inc,target,steps)=>`<td><b>${fmtE(val)}</b>${pil(inc,target,steps)}</td>`;
  const riga=(x,classe)=>{
    const iru=x.ru/x.ricavi, imp=x.mp/x.ricavi, isg=x.sg/x.ricavi, iro=x.ro/x.ricavi;
    return `<tr class="${classe||''}">
      <td>${x.mese}</td>
      <td><b>${fmtE(x.ricavi)}</b></td>
      ${cella(x.ru,iru,t.ru)}
      ${cella(x.mp,imp,t.mp)}
      ${cella(x.sg,isg,t.sg)}
      <td class="ro"><b style="color:${x.ro<0?'var(--bad)':'var(--ok)'}">${fmtE(x.ro)}</b>${pilRo(iro)}</td>
    </tr>`;
  };
  const tot=sumRows(m.complete, m.orphanCosts);
  tot.mese='Totale'; tot.ricavi=tot.ricavi; tot.ro=tot.ro;
  return `<section>
    <h2>Quadro mese per mese</h2>
    <div class="sub">Per ogni centro di costo l'importo del mese e, accanto, la sua incidenza sui ricavi a semaforo.${isM?' Il mese selezionato è evidenziato.':''}</div>
    <div style="overflow-x:auto"><table class="obtable quadro">
      <tr><th>Mese</th><th>Fatturato</th><th>Risorse umane</th><th>Materia prima</th><th>Spese generali</th><th>Margine operativo</th></tr>
      ${riga(tot,'tot')}
      ${m.complete.map(x=>riga(x, isM&&x.i===scope?'cur':'')).join('')}
    </table></div>
  </section>`;
}

/* scheda del riepilogo per area, con il colore della zona di allerta del centro di costo */
function areaCard(pagina, nome, euro, inc, target, steps, riga2, azione){
  const z=isFinite(inc)?zone(inc,target,steps):0;
  return `<div class="acard z${z}" data-goto="${pagina}">
    <div class="al">${nome}<span class="verdict ${ZC[z]}">${ZN[z]}</span></div>
    <div class="av">${fmtE(euro)}</div>
