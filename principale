    let mf=num(row.mp_food), mb=num(row.mp_beverage);
    if(rf>0&&rb===0&&noteStr.includes('split mancante ricavi')){ const t=rf; rf=t*rRatio; rb=t*(1-rRatio); splitR=true; }
    if(mf>0&&mb===0&&noteStr.includes('split mancante mp')){ const t=mf; mf=t*mRatio; mb=t*(1-mRatio); splitM=true; }
    if(rf||rb||ra||mf||mb){ ceSet(i,{rf:+rf.toFixed(2),rb:+rb.toFixed(2),ra:+ra.toFixed(2),mf:+mf.toFixed(2),mb:+mb.toFixed(2)}); applied++; }
    if(num(row.personale)>0){ ruM[i]=num(row.personale); hasRU=true; }
    if(num(row.spese_generali)>0){ sgM[i]=num(row.spese_generali); hasSG=true; }
  });
  if(!applied&&!hasRU&&!hasSG) throw new Error('mesi non riconosciuti nel documento');
  if(hasRU){
    let pr=S.ru.find(x=>x.nome==='Personale (da conto economico)');
    if(!pr){ pr={id:newId(),reparto:'Sala',nome:'Personale (da conto economico)',ruolo:'per incidenze',m:zeros()}; S.ru.push(pr); }
    MESI.forEach((_,i)=>{ if(ruM[i]>0) pr.m[i]=ruM[i]; });
  }
  if(hasSG){
    let c=S.sg.find(x=>x.nome==='Spese generali (da conto economico, totale)');
    if(!c){ c={id:newId(),gruppo:'Costi Gestionali Struttura',nome:'Spese generali (da conto economico, totale)',m:zeros()}; S.sg.unshift(c); }
    MESI.forEach((_,i)=>{ if(sgM[i]>0) c.m[i]=sgM[i]; });
  }
  scope='ytd'; renderAll(); saveState();
  const extra=[hasRU?'personale':'',hasSG?'spese generali':''].filter(Boolean).join(' e ');
  const splits=[splitR?`ricavi divisi ${fmtP(rRatio)}/${fmtP(1-rRatio)}`:'',splitM?`materia prima divisa ${fmtP(mRatio)}/${fmtP(1-mRatio)}`:''].filter(Boolean).join('; ');
  return `${fname}: ${applied} mesi compilati${extra?' + '+extra:''}.`+(splits?' '+splits+'.':'')+(res.note&&!noteStr.includes('split')?' Nota: '+res.note:'');
}
