/* ================================================================
   QUADRANTI · fatturato con break-even e obiettivo, margine operativo
   Disegnati in SVG: nessuna libreria, stampabili e nitidi a ogni zoom.
================================================================ */
const GA={w:320, h:176, cx:160, cy:150, r:104, sw:18};
function gaPoint(t,r){ const a=Math.PI+Math.max(0,Math.min(1,t))*Math.PI;
  return [GA.cx+r*Math.cos(a), GA.cy+r*Math.sin(a)]; }
function gaArc(t0,t1,r){
  if(t1<=t0) return '';
  const [x0,y0]=gaPoint(t0,r), [x1,y1]=gaPoint(t1,r);
  /* il quadrante è mezzo giro: nessun arco supera i 180°, quindi large-arc-flag resta 0 */
  return `M${x0.toFixed(2)} ${y0.toFixed(2)} A${r} ${r} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`;
}
function gaTick(t,label){
  const [x0,y0]=gaPoint(t,GA.r-GA.sw/2-2), [x1,y1]=gaPoint(t,GA.r+GA.sw/2+7);
  const [lx,ly]=gaPoint(t,GA.r+GA.sw/2+21);
  return `<line x1="${x0.toFixed(1)}" y1="${y0.toFixed(1)}" x2="${x1.toFixed(1)}" y2="${y1.toFixed(1)}" stroke="var(--ink)" stroke-width="2"/>
    <text x="${lx.toFixed(1)}" y="${(ly+4).toFixed(1)}" class="gatick" text-anchor="middle">${label}</text>`;
}
function gaNeedle(t){
  const [x,y]=gaPoint(t,GA.r-26);
  return `<line x1="${GA.cx}" y1="${GA.cy}" x2="${x.toFixed(1)}" y2="${y.toFixed(1)}" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/>
          <circle cx="${GA.cx}" cy="${GA.cy}" r="7" fill="var(--ink)"/>`;
}
/* fasce: [tFine, colore] in ordine crescente. Le fasce restano tenui (indicano le zone),
   l'arco pieno del valore raggiunto è nel colore della zona in cui ci si trova. */
function gaugeSVG(fasce, tVal, ticks, colVal){
  let d='', prev=0;
  fasce.forEach(([tf,col])=>{
    const p=gaArc(prev,tf,GA.r);
    if(p) d+=`<path d="${p}" stroke="${col}" stroke-width="${GA.sw}" stroke-opacity=".28" fill="none"/>`;
    prev=tf;
  });
  const pv=gaArc(0,Math.max(0,Math.min(1,tVal)),GA.r);
  if(pv) d+=`<path d="${pv}" stroke="${colVal}" stroke-width="${GA.sw-8}" fill="none"/>`;
  return `<svg class="gasvg" viewBox="0 0 ${GA.w} ${GA.h}" role="img">
    ${d}${(ticks||[]).join('')}${gaNeedle(tVal)}
  </svg>`;
}
function dashGauges(a, t, isM, ricaviNote){
  if(!(a.ricavi>0)) return '';
  const costi = a.ricavi - a.ro;                 // BE: tutti i centri di costo del periodo
  const be = costi;
  const utile = Math.min(Math.max(num(t.ro),0),90);
  const obiettivo = be/(1-utile/100);            // BE/(100-utile)*100
  /* Scala a tacche fisse: il pareggio sta sempre a metà quadrante, l'obiettivo a tre quarti.
     È la scala ad adattarsi al cliente, non le tacche — così due clienti si leggono allo stesso modo.
     Prima metà: da 0 al pareggio. Poi passi uguali di (obiettivo − pareggio) per ogni quarto. */
  const passo = obiettivo-be;
  /* l'ultimo quarto si allarga se il fatturato va oltre, così la lancetta non resta incollata al fondo */
  const topF = Math.max(obiettivo+(passo||1), a.ricavi*1.08);
  const T = v => {
    if(!(be>0)) return Math.max(0,Math.min(1, obiettivo>0 ? v/(obiettivo*1.34) : 0));
    if(v<=0) return 0;
    if(v<=be) return .5*v/be;
    if(v<=obiettivo) return .5+.25*(v-be)/(passo||1);
    return Math.min(1, .75+.25*(v-obiettivo)/(topF-obiettivo));
  };
  const sopraBE = a.ricavi>=be, sopraO = a.ricavi>=obiettivo;
  const colF = !sopraBE?'var(--bad)':!sopraO?'var(--warn)':'var(--ok)';
  /* sotto il pareggio la fascia è neutra: non è "molto male", è strada da fare.
     Lo stato lo dice l'arco pieno del valore, non lo sfondo. */
  const fatturatoSvg = gaugeSVG(
    [[T(be),'var(--ink2)'], [T(obiettivo),'var(--warn)'], [1,'var(--ok)']],
    T(a.ricavi),
    [ gaTick(T(be),'BE'), gaTick(T(obiettivo),'O') ],
    colF
  );
  const verdetto = !sopraBE
    ? `<span class="verdict v-bad">sotto il pareggio di ${fmtE(be-a.ricavi)}</span>`
    : !sopraO
      ? `<span class="verdict v-warn">sopra il pareggio · ${fmtE(obiettivo-a.ricavi)} all'obiettivo</span>`
      : `<span class="verdict v-ok">obiettivo raggiunto</span>`;

  /* margine operativo in percentuale sui ricavi, con le stesse tacche fisse del fatturato:
     il pareggio (margine zero) a metà quadrante, l'obiettivo a tre quarti.
     Ogni quarto vale un "obiettivo" di punti percentuali. */
  const roPct = a.ricavi>0 ? a.ro/a.ricavi*100 : 0;
  const uM = Math.max(utile,1);
  const botM = Math.min(-2*uM, roPct*1.08);   // negativo
  const topM = Math.max(2*uM, roPct*1.08);
  const TM = v => {
    if(v<=0) return Math.max(0, .5 + .5*v/(-botM));
    if(v<=uM) return .5 + .25*v/uM;
    return Math.min(1, .75 + .25*(v-uM)/((topM-uM)||1));
  };
  const colM = roPct<0?'var(--bad)':roPct<utile?'var(--warn)':'var(--ok)';
  const margineSvg = gaugeSVG(
    [[TM(0),'var(--bad)'], [TM(utile),'var(--warn)'], [1,'var(--ok)']],   // qui sotto zero è perdita vera
    TM(roPct),
    [ gaTick(TM(0),'BE'), gaTick(TM(utile),'O') ],
    colM
  );
  const recupero = a.ricavi*(utile/100)-a.ro;
  return `<div class="gaugegrid">
    <div class="gaugecard">
      <div class="ghead">Fatturato${isM?' · '+MESI[scope]:''}</div>
      ${fatturatoSvg}
      <div class="gval">${fmtE(a.ricavi)}</div>
      <div class="gnote">${verdetto}</div>
      <div class="gnote small">pareggio <b>${fmtE(be)}</b> · obiettivo <b>${fmtE(obiettivo)}</b><br><span class="gsub">${ricaviNote||''}</span></div>
    </div>
    <div class="gaugecard">
      <div class="ghead">Margine operativo${isM?' · '+MESI[scope]:''}</div>
      ${margineSvg}
      <div class="gval ${a.ro<0?'neg':'pos'}">${fmtE(a.ro)}</div>
      <div class="gnote"><span class="verdict ${roPct<0?'v-bad':roPct<utile?'v-warn':'v-ok'}">${fmtP(a.ro/a.ricavi)} sui ricavi</span></div>
      <div class="gnote small">
        ${a.ro<0 ? `mancano <b>${fmtE(-a.ro)}</b> al pareggio` : `<b>${fmtE(a.ro)}</b> sopra il pareggio`}<br>
        ${recupero>0 ? `mancano <b>${fmtE(recupero)}</b> all'obiettivo del ${utile}%` : `<b>${fmtE(-recupero)}</b> oltre l'obiettivo del ${utile}%`}
      </div>
    </div>
    <div class="gaugeside">
      <div class="kpi"><div class="lbl">Costi nascosti intercettati</div><div class="val">${fmtE(a.cn)}</div><div class="note">${fmtP(a.incCn)} del venduto · max ${t.cn}% — sono già dentro la materia prima</div></div>
      <div class="kpi highlight"><div class="lbl">${recupero>0?'Recupero potenziale':'Oltre l\'obiettivo'}</div><div class="val">${fmtE(Math.abs(recupero))}</div><div class="note">${recupero>0?`portando l'utile all'obiettivo del ${utile}%${isM?' nel mese':''}`:`utile già sopra l'obiettivo del ${utile}%${isM?' nel mese':''}`}</div></div>
    </div>
  </div>`;
}

/* riquadro merchandising: le stesse voci lette con e senza merchandising */
function merchBoxHTML(m, isM){
  if(!hasMerchData()) return '';
  const M=merchMode();
  /* il riquadro guarda sempre lo stesso periodo, qualunque sia l'interruttore */
  const rows = isM ? [m.months[scope]] : m.months.filter(x=>x.ricaviCore+x.ricaviMerch>0 || x.costiCore+x.costiMerch>0);
  const Sm = k => rows.reduce((acc,x)=>acc+x[k],0);
  const a = {ricaviCore:Sm('ricaviCore'), ricaviMerch:Sm('ricaviMerch'), costiCore:Sm('costiCore'), costiMerch:Sm('costiMerch')};
  const ricInc=a.ricaviCore+a.ricaviMerch, ricEsc=a.ricaviCore;
  const cosInc=a.costiCore+a.costiMerch,  cosEsc=a.costiCore;
  const marInc=ricInc-cosInc,             marEsc=ricEsc-cosEsc;
  const marMer=a.ricaviMerch-a.costiMerch;
  const stato = M==='incl'?'acceso · i conti qui sotto comprendono il merchandising'
              : M==='escl'?'spento · i conti qui sotto sono al netto del merchandising'
              : 'isolato · i conti qui sotto sono solo merchandising';
  const riga=(nome,inc,esc)=>`<tr><td>${nome}</td><td><b>${fmtE(inc)}</b></td><td><b>${fmtE(esc)}</b></td><td class="dd">${fmtE(inc-esc)}</td></tr>`;
  return `<div class="merchbox">
    <div class="mt">Merchandising · ${stato}</div>
    <table>
      <tr><th>${isM?MESI[scope]:'Periodo consuntivato'}</th><th>incl. merchandising</th><th>escl. merchandising</th><th>solo merchandising</th></tr>
      ${riga('Incasso totale', ricInc, ricEsc)}
      ${riga('Spese totali', cosInc, cosEsc)}
      ${riga('Margine operativo', marInc, marEsc)}
    </table>
    <div class="note" style="margin-top:9px;font-size:12px;color:var(--ink2)">
      Il merchandising porta ${fmtE(a.ricaviMerch)} di ricavi e ${fmtE(a.costiMerch)} di costi: ${marMer>=0?'contribuisce con':'pesa per'} <b>${fmtE(Math.abs(marMer))}</b> di margine${a.ricaviMerch>0?` · marginalità ${fmtP(marMer/a.ricaviMerch)}`:''}.
    </div>
  </div>`;
}
