let pdfjsLib=null;
async function loadPdfJs(){
  if(pdfjsLib) return pdfjsLib;
  await new Promise((ok,ko)=>{ const s=document.createElement('script');
    s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    s.onload=ok; s.onerror=()=>ko(new Error('impossibile caricare il lettore PDF (connessione al CDN bloccata)'));
    document.head.appendChild(s); });
  pdfjsLib=window['pdfjs-dist/build/pdf'];
  const wurl='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  try{ // worker come blob: funziona anche negli ambienti sandbox che bloccano i worker cross-origin
    const code=await (await fetch(wurl)).text();
    pdfjsLib.GlobalWorkerOptions.workerSrc=URL.createObjectURL(new Blob([code],{type:'text/javascript'}));
  }catch(e){ pdfjsLib.GlobalWorkerOptions.workerSrc=wurl; }
  return pdfjsLib;
}
function itNum(s){
  s=String(s).trim().replace(/[€\s]/g,'');
  if(!/^[-+(]?[\d.,]+\)?$/.test(s)) return null;
  const neg=/^\(.*\)$/.test(s)||s.startsWith('-'); s=s.replace(/[()+-]/g,'');
  if(s.includes(',')) s=s.replace(/\./g,'').replace(',','.');
  else if((s.match(/\./g)||[]).length>1) s=s.replace(/\./g,'');
  const v=parseFloat(s); if(isNaN(v)) return null; return neg?-v:v;
}
async function pdfToLines(buf){
  const lib=await loadPdfJs();
  const doc=await lib.getDocument({data:buf}).promise;
  const lines=[];
  for(let p=1;p<=Math.min(doc.numPages,12);p++){
    const page=await doc.getPage(p);
    const tc=await page.getTextContent();
    const rows={};
    tc.items.forEach(it=>{
      const y=Math.round(it.transform[5]/3)*3;
      (rows[y]=rows[y]||[]).push({x:it.transform[4], s:it.str});
    });
    Object.keys(rows).map(Number).sort((a,b)=>b-a).forEach(y=>{
      const line=rows[y].sort((a,b)=>a.x-b.x).map(i=>i.s).join(' ').replace(/\s+/g,' ').trim();
      if(line) lines.push(line);
    });
  }
  if(lines.join('').replace(/\s/g,'').length<40)
    throw new Error('il PDF non contiene testo selezionabile: è una scansione. Serve l\'analisi AI (app aperta dentro Claude) oppure chiedi il file in Excel.');
  return lines;
}
function lineLabelNums(ln){
  // estrae etichetta + numeri; tollera il codice conto iniziale (es. "60.01.001 Acquisti merci 5.000,00")
  let m=ln.match(/^([^\d(]+?)\s+([-+(]?\d[\d.,()€\s%]*)$/);
  if(!m){
    const ln2=ln.replace(/^\s*[\d.,\/]+\s+/,'');
    if(ln2!==ln) m=ln2.match(/^([^\d(]+?)\s+([-+(]?\d[\d.,()€\s%]*)$/);
  }
  if(!m) return null;
  const nums=m[2].trim().split(/\s+/).filter(t=>!t.includes('%')).map(itNum).filter(v=>v!=null);
  return {label:m[1], nums};
}
function monthFromText(txt){
  if(!txt) return -1;
  for(const t of String(txt).toLowerCase().split(/[^a-zà-ù]+/)){
    const mi=monthIdx(t); if(mi>=0) return mi;
  }
  const sTxt=String(txt);
  let m=sTxt.match(/(?:^|[^0-9])(0?[1-9]|1[0-2])[\-_.\/](?:20\d{2}|\d{2})(?:[^0-9]|$)/);      // 03-2026
  if(m) return +m[1]-1;
  m=sTxt.match(/(?:20\d{2}|^|[^0-9])[\-_.\/](0?[1-9]|1[0-2])(?:[^0-9]|$)/);                    // 2026_04
  if(m) return +m[1]-1;
  m=sTxt.toLowerCase().match(/mese\s*(0?[1-9]|1[0-2])/);
  if(m) return +m[1]-1;
  return -1;
}
/* --- "Situazione contabile costi/ricavi" (stampato del commercialista con codici conto) --- */
const TRIP=/(\d[\d.\/]{2,10}\d)\s+(.+?)\s+(\d{1,3}(?:\.\d{3})*,\d{2})(?=\s|$)/g;
function classifyConto(code,label){
  const cd=String(code||'').replace(/\D/g,'');
  const l=norm(label);
  if(cd[0]==='9'||/^ricav|^corrispettiv|^vendite|^incass|^aggi\b|^aggio\b/.test(l)){
    return /tabac|aggi|bigliett|profumeria|lottomatic/.test(l)?['ra']:['rTot'];
  }
  if(cd.startsWith('803')||/salari|stipend|contributi inps|inail|polizze sanitarie|tfr|costo del personale/.test(l)) return ['ru'];
  if(cd.startsWith('822')||/indeducibil/.test(l)) return ['skip'];
  if(cd.startsWith('801')||/^acquist|materie prime|^merc[ei]\b/.test(l)){
    if(/tabac|profumeria/.test(l)) return ['sg','Altri costi / Servizi','Acquisti tabacchi/profumeria (da CE)'];
    if(/carburant|autovettur/.test(l)) return ['sg','Altri costi / Servizi','Gestione veicoli aziendali'];
    if(/consumo/.test(l)) return ['sg','Altri costi / Servizi','Materiali di consumo e sussidiarie'];
    return ['mTot'];
  }
  const map=[
    [/telefon/,'Costi Gestionali Struttura','Telefoniche Fisse e cellulari'],
    [/riscald|\bgas\b/,'Costi Gestionali Struttura','Gas'],
    [/energia|enel|luce/,'Costi Gestionali Struttura','Energia Elettrica'],
    [/acqua/,'Costi Gestionali Struttura','Acqua'],
    [/pulizi/,'Costi Gestionali Struttura','Pulizie'],
    [/locazion|affitt/,'Costi Gestionali Struttura','Affitti'],
    [/oneri bancari|commission/,'Banche - Tasse - Imposte','Oneri bancari, mutui (quota capitale)'],
    [/\biva\b|imposte|tribut|\btasse\b|bolli/,'Banche - Tasse - Imposte','Oneri Tributari - Altre Imposte e Tasse'],
    [/compensi professional|commercial|consulen|paghe/,'Consulenze esterne','Commercialista'],
    [/manut/,'Altri costi / Servizi','Manutenzione attrezzatura specifica'],
    [/canone|noleggi/,'Altri costi / Servizi','Noleggio Software Cassa'],
    [/lottomatic|sisal|totobit/,'Altri costi / Servizi','Altri servizi deducibili (Sisal / Lis)'],
    [/trasport/,'Altri costi / Servizi','Trasporti su acquisti'],
    [/assicur/,'Altri costi / Servizi','Assicurazioni'],
    [/giornal|rivist|pubblicit/,'Formazione & Pubblicità generica','Pubblicità generica (web, social, altro)']
  ];
  for(const [re,g,n] of map) if(re.test(l)) return ['sg',g,n];
  return ['sg','Altri costi / Servizi','Spese generali Extra'];
}
async function parseContabile(lines, fname){
  const rec=[];
  for(const ln of lines){ let m; TRIP.lastIndex=0; while((m=TRIP.exec(ln))){ rec.push({code:m[1],label:m[2].trim(),val:itNum(m[3])}); } }
  if(rec.length<5) return null; // non è questo formato
  let mi=-1;
  for(const ln of lines){ const m=ln.match(/(\d{1,2})[\/\.\-](\d{1,2})[\/\.\-](\d{2,4})\s*[-–]\s*\d{1,2}[\/\.\-]\d{1,2}[\/\.\-]\d{2,4}/);
    if(m){ mi=+m[2]-1; const y=m[3].length===2?'20'+m[3]:m[3]; S.anno=+y; break; } }
  if(mi<0) mi=monthFromText(fname);
  if(mi<0) mi=monthFromText(lines.slice(0,15).join(' '));
  if(mi<0){ const ans=await uiPrompt('A quale mese si riferisce questa situazione contabile? (es. Gennaio)',''); mi=ans?monthIdx(ans):-1; }
  if(mi<0||mi>11) return {ok:false,msg:'mese non indicato: impossibile importare la situazione contabile'};
  const ceM=S.ce[mi];
  if(ceM && (num(ceM.rf)+num(ceM.rb)+num(ceM.ra)+num(ceM.mf)+num(ceM.mb))>0){
    const okOver=await uiConfirm('Ho riconosciuto il mese di '+MESI[mi]+', che però contiene già dati. Sovrascrivo con questo documento?');
    if(!okOver){
      const ans=await uiPrompt('Su quale mese vuoi caricarlo allora? (es. Febbraio)','');
      const mi2=ans?monthIdx(ans):-1;
      if(mi2<0||mi2>11) return {ok:false,msg:'import annullato'};
      mi=mi2;
    }
  }
  let rTot=0,ra=0,mTot=0,ru=0,skip=0; const sgv={};
  rec.forEach(r=>{ const c=classifyConto(r.code,r.label);
    if(c[0]==='rTot')rTot+=r.val; else if(c[0]==='ra')ra+=r.val; else if(c[0]==='mTot')mTot+=r.val;
    else if(c[0]==='ru')ru+=r.val; else if(c[0]==='skip')skip+=r.val;
    else { const key=c[1]+'|'+c[2]; sgv[key]=(sgv[key]||0)+r.val; } });
  // conto economico del mese (split F/B con le proporzioni correnti)
  const cur=compute();
  const rR=monthSplitR(mi, (cur.ricaviFood+cur.ricaviBev)>0?cur.ricaviFood/(cur.ricaviFood+cur.ricaviBev):.5);
  const mR=monthSplitR(mi, (cur.mpFood+cur.mpBev)>0?cur.mpFood/(cur.mpFood+cur.mpBev):.5);
  ceSet(mi,{rf:+(rTot*rR).toFixed(2), rb:+(rTot*(1-rR)).toFixed(2), ra:+ra.toFixed(2),
            mf:+(mTot*mR).toFixed(2), mb:+(mTot*(1-mR)).toFixed(2)});
  // personale del mese: riga dedicata (aggiornata mese per mese)
  if(ru>0){
    let pr=S.ru.find(x=>x.nome==='Personale (da bilancino)');
    if(!pr){ pr={id:newId(),reparto:'Sala',nome:'Personale (da bilancino)',ruolo:'per incidenze',m:zeros()}; S.ru.push(pr); }
    pr.m[mi]=+ru.toFixed(2);
  }
  // spese generali voce per voce nel mese
  let nSg=0;
  Object.entries(sgv).forEach(([key,val])=>{
    const [g,n]=key.split('|');
    let c=S.sg.find(x=>x.nome===n);
    if(!c){ c={id:newId(),gruppo:g,nome:n,m:zeros()}; S.sg.push(c); }
    c.m[mi]=+val.toFixed(2); nSg++;
  });
  let msg=`${MESI[mi]} da situazione contabile: ricavi F&B ${fmtE(rTot)} + altri ricavi ${fmtE(ra)} (tabacchi/aggi), materia prima ${fmtE(mTot)}, personale ${fmtE(ru)}, ${nSg} voci di spese generali (${fmtE(Object.values(sgv).reduce((a,b)=>a+b,0))}).`;
  if(skip>0) msg+=` Esclusi ${fmtE(skip)} di costi indeducibili (voce fiscale, non gestionale).`;
  msg+=' Carica gli altri bilancini mensili uno dopo l\'altro.';
  return {ok:true,msg};
}
async function parsePdfCE(lines, fname){
  /* 0) situazione contabile del commercialista (codici conto, due colonne) */
  const cont=await parseContabile(lines, fname);
  if(cont) return cont;
  /* 1) tabella multi-mese */
  let monthsOrder=null;
  for(const ln of lines){
    const found=[];
    ln.split(/\s+/).forEach(t=>{ const mi=monthIdx(t); if(mi>=0&&!found.includes(mi)) found.push(mi); });
    if(found.length>=3){ monthsOrder=found; break; }
  }
  const acc={rf:zeros(),rb:zeros(),ra:zeros(),mf:zeros(),mb:zeros(),rTot:zeros(),mTot:zeros(),rfm:zeros(),rbm:zeros(),mfm:zeros(),mbm:zeros()};
  const seen={rf:0,rb:0,mf:0,mb:0,rTot:0,mTot:0,ra:0,rfm:0,rbm:0,mfm:0,mbm:0};
  if(monthsOrder){
    for(const ln of lines){
      const lm=lineLabelNums(ln); if(!lm) continue;
      const k=classifyCE(lm.label); if(!k||!lm.nums.length) continue;
      seen[k]++;
      monthsOrder.forEach((mi,j)=>{ if(lm.nums[j]!=null) acc[k][mi]+=lm.nums[j]; });
    }
