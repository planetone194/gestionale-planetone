  await stDel('planetone-fb:'+id);
  CLIENTS.deleted=CLIENTS.deleted||[];
  if(!CLIENTS.deleted.includes(id)) CLIENTS.deleted.push(id);
  const eraAttivo = (id===CLIENTS.activeId);
  CLIENTS.list=CLIENTS.list.filter(x=>x.id!==id);
  await stSet('planetone-clients', JSON.stringify(CLIENTS));
  if(eraAttivo){ CLIENTS.activeId=null; await switchClient(CLIENTS.list[0].id); }
  else { renderClientSelect(); }
  if(current==='home') renderHome();
  toast('Cliente "'+nome+'" eliminato.');
