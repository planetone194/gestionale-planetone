function cellNum(v){
  if(typeof v==='number'&&isFinite(v)) return v;
  if(typeof v==='string'){ const x=itNum(v.replace(/€/g,'').trim()); return x!=null?x:0; }
  return 0;
}
const REP_SEC={'bar':'Bar','sala':'Sala','cucina':'Cucina','management':'Management','indirett':'Management'};
function repFromLabel(ln){ for(const k in REP_SEC){ if(ln===k||ln.startsWith(k+' ')||ln.startsWith(k)) return REP_SEC[k]; } return null; }
/* layout Planet One: mesi in colonna + sezioni BAR/SALA/CUCINA (es. "COSTO PERSONALE LORDO ... LOCALE: AL BARCOLLO") */
async function tryRUMulti(g, srcName){
  let hr=-1; const mcols={};
  for(let r=0;r<Math.min(g.length,12);r++){
    const found={};
    (g[r]||[]).forEach((v,c)=>{ const mi=monthIdx(v); if(mi>=0&&found[mi]==null) found[mi]=c; });
    if(Object.keys(found).length>=3){ hr=r; Object.assign(mcols,found); break; }
  }
  if(hr<0) return null;
  /* colonne di testo: la prima è il nome, la seconda il ruolo (serve per le righe Merchandising) */
  const mset1=new Set(Object.values(mcols).map(Number));
  const textCols=[]; const head=g[hr]||[];
  for(let c=0;c<Math.max(head.length, Math.min(...mset1)); c++) if(!mset1.has(c)) textCols.push(c);
  const cName = textCols.length?textCols[0]:0, cRole = textCols.length>1?textCols[1]:-1;
  const isMerchRow=(row)=>{
    const nome=String(row[cName]==null?'':row[cName]).trim();
    const ruolo=cRole>=0?String(row[cRole]==null?'':row[cRole]).trim():'';
    if(/merchandis/i.test(ruolo) && !nome) return true;          // formato del template
    if(/^[↳\-·\s]*merchandis/i.test(nome)) return true;          // scritto nella colonna del nome
    return false;
  };
  let rep=null; const items=[]; let cur=null;   // cur = ultima persona letta, anche se la sua riga costo è vuota
  const pushCur=()=>{ if(cur && !cur.pushed){ items.push(cur); cur.pushed=true; } };
  for(let r=hr+1; r<g.length; r++){
    const row=g[r]||[];
    /* riga Merchandising: appartiene alla persona della riga sopra */
    if(isMerchRow(row)){
      if(cur){
        Object.entries(mcols).forEach(([mi,c])=>{ const v=cellNum(row[c]); if(v!==0) cur.mk[mi]=v; });
        if(Object.keys(cur.mk).length) pushCur();   // una persona con solo merchandising va comunque caricata
      }
      continue;
    }
    const label=row.find(v=>typeof v==='string'&&v.trim());
    if(!label){ cur=null; continue; }
    const ln=norm(label);
    const hasVals=Object.values(mcols).some(c=>cellNum(row[c])!==0);
    const sec=repFromLabel(ln);
    if(sec && !hasVals){ rep=sec; cur=null; continue; }
    /* riga dei totali del file paghe: si riconosce perché non ha un ruolo accanto.
       Una persona che si chiama "Totale personale" con un ruolo indicato va invece caricata. */
    const ruoloCella = cRole>=0 ? String(row[cRole]==null?'':row[cRole]).trim() : '';
    if(/^total/.test(ln) && !ruoloCella){ cur=null; continue; }
    // ruolo: seconda cella testuale fuori dalle colonne dei mesi (es. "Bartender", "30 ore")
    const mset0=new Set(Object.values(mcols).map(Number));
    let ruolo=''; let seen=false;
    row.forEach((v,c)=>{ if(ruolo||mset0.has(c)) return;
      if(typeof v==='string'&&v.trim()&&cellNum(v)<=0){ if(!seen){seen=true;} else ruolo=v.trim(); } });
    const months={};
    Object.entries(mcols).forEach(([mi,c])=>{ const v=cellNum(row[c]); if(v!==0) months[mi]=v; });
    cur={label:label.trim(), ruolo, rep:rep||'Sala', months, mk:{}, pushed:false};
    if(hasVals) pushCur();
  }
  if(!items.length) return null;
  let matched=0, created=0, tot=0, totMk=0; const mset=new Set();
  items.forEach(it=>{
    let p=matchPerson(it.label);
    if(!p){ p={id:newId(),reparto:it.rep,nome:it.label,ruolo:it.ruolo,m:zeros(),mk:Array(12).fill(0),ore:Array(7).fill(0)}; S.ru.push(p); created++; }
    else{ matched++; p.reparto=it.rep; if(it.ruolo&&!p.ruolo) p.ruolo=it.ruolo; if(!Array.isArray(p.mk)||p.mk.length!==12) p.mk=Array(12).fill(0); }
    Object.entries(it.months).forEach(([mi,v])=>{ p.m[+mi]=+v.toFixed(2); tot+=v; mset.add(+mi); });
    Object.entries(it.mk||{}).forEach(([mi,v])=>{ p.mk[+mi]=+v.toFixed(2); totMk+=v; mset.add(+mi); });
  });
  renderRU(); renderDash(); saveState();
  const mesi=[...mset].sort((a,b)=>a-b);
  const range=mesi.length?(MESI[mesi[0]].slice(0,3)+'–'+MESI[mesi[mesi.length-1]].slice(0,3)):'';
  return `${items.length} persone caricate (${matched} aggiornate, ${created} nuove) su ${mesi.length} mesi (${range}) · ${fmtE(tot)} di costo personale${totMk?' + '+fmtE(totMk)+' di merchandising':''}, reparti assegnati dalle sezioni del file.`;
}
async function importRUFile(file){
  const msg=document.getElementById('ruImportMsg'); if(msg) msg.textContent='Lettura del file paghe…';
  try{
    if(!(/\.pdf$/i.test(file.name)||file.type==='application/pdf')){
      const wb=XLSX.read(await file.arrayBuffer(),{type:'array'});
      for(const n of wb.SheetNames){
        const g=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:null});
        const res=await tryRUMulti(g, file.name);
        if(res){ if(msg) msg.textContent='✓ '+res; toast('✓ File paghe importato.'); return; }
      }
    }
    /* fallback: elenco semplice nome + importo (un mese) */
    const items=[];
    if(/\.pdf$/i.test(file.name)||file.type==='application/pdf'){
      const lines=await pdfToLines(await file.arrayBuffer());
      lines.forEach(ln=>{ const lm=lineLabelNums(ln); if(lm&&lm.nums.length) items.push({label:lm.label.trim(), val:lm.nums[lm.nums.length-1]}); });
    } else {
      const wb=XLSX.read(await file.arrayBuffer(),{type:'array'});
      const g=XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{header:1,raw:true,defval:null});
      let valCol=-1;
      for(let r=0;r<Math.min(g.length,8);r++){
        (g[r]||[]).forEach((v,c)=>{ if(valCol<0 && /costo|lordo|importo|retribuz|stipend|totale|paga/.test(norm(v))) valCol=c; });
        if(valCol>=0) break;
      }
      g.forEach(row=>{
        if(!row) return;
        const label=row.find(v=>typeof v==='string'&&v.trim()); if(!label) return;
        let val=null;
        if(valCol>=0) val=cellNum(row[valCol])||null;
        if(val==null){ for(let c=row.length-1;c>=0;c--){ const x=cellNum(row[c]); if(x>0){ val=x; break; } } }
        if(val!=null) items.push({label:label.trim(), val:num(val)});
      });
    }
    await applyRUItems(items, file.name);
  }catch(e){ const t='Impossibile leggere il file paghe: '+e.message; if(msg) msg.textContent='⚠️ '+t; toast(t,true); }
}
