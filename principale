let scope='ytd';
function sumRows(rows, orphanCosts){
  const Sm=k=>rows.reduce((a,x)=>a+x[k],0);
  const o={ n:rows.length, ricavi:Sm('ricavi'), ru:Sm('ru'), mp:Sm('mp'), sg:Sm('sg'), cn:Sm('cn'),
    ricaviFood:Sm('rf'), ricaviBev:Sm('rb'), mpFood:Sm('mf'), mpBev:Sm('mb'),
    ruFood:Sm('ruF'), ruBev:Sm('ruB'), sgFood:Sm('sgF'), sgBev:Sm('sgB'), totCosti:Sm('totCosti'),
    ricaviCore:Sm('ricaviCore'), ricaviMerch:Sm('ricaviMerch'), costiCore:Sm('costiCore'), costiMerch:Sm('costiMerch') };
  o.ro = o.ricavi - o.ru - o.mp - o.sg - (orphanCosts||0);
  o.incRu=o.ru/o.ricavi; o.incMp=o.mp/o.ricavi; o.incSg=o.sg/o.ricavi; o.incCn=o.cn/o.ricavi;
