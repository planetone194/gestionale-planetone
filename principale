<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Planet One · Gestionale F&amp;B</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ================= PALETTE PLANET ONE =================
     Tutti i colori dell'app stanno qui sotto. Ogni tinta ha un solo significato:
       --brand   antracite · interfaccia: pulsanti, testate, Recupero potenziale
       --scuro   nero      · menu laterale
       --brass   arancio   · identità Planet One: logo, voce attiva, accenti
       --ok/warn/hot/bad   · stato del dato: in obiettivo, giallo, arancio, rosso
       --food/--bev        · business unit: viola Food, azzurro Beverage
       --porpora           · merchandising
     PER TORNARE ALLA VERSIONE VERDE E OCRA basta rimettere queste tre righe:
       --brand:#14484F; --brand-dk:#0d353b; --brass:#B98A2F;
       --hot:#D9741A;  --hot-bg:#FAEADC;
       --scuro:#FFFFFF  (e il menu laterale torna chiaro: vedi .side e #nav)
     ====================================================== */
  :root{
    --bg:#F5F4F0; --card:#FFFFFF; --ink:#1B2A3A; --ink2:#5D6B79; --line:#E4E1DA;
    --brand:#2F3337; --brand-dk:#1B1E21; --brass:#F07F1F; --brass-dk:#B95E0C;
    --scuro:#272727; --scuro-2:#333333;
    --ok:#2E7D4F; --warn:#D9A620; --hot:#B4501A; --bad:#C0392B;
    --porpora:#8C3A57; --porpora-bg:#F7EBEF;
    /* identità delle business unit: viola = Food, azzurro = Beverage. Non si usano per altro. */
    --food:#8355F7; --food-dk:#5B2FCC; --food-bg:#F0EAFE;
    --bev:#58BDDA; --bev-dk:#22778F; --bev-bg:#E6F4F9;
    --ok-bg:#EAF4EE; --warn-bg:#FBF3DC; --hot-bg:#F4E2D8; --bad-bg:#F7E4E1;
    --radius:14px; --num:'IBM Plex Mono',ui-monospace,monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--ink);font-family:'Inter',system-ui,sans-serif;font-size:15px;line-height:1.5;}
  .wrap{max-width:1180px;margin:0 auto;padding:24px 22px 60px;}

  header{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;
    border-bottom:2px solid var(--ink);padding-bottom:14px;}
  .logo{display:flex;align-items:baseline;gap:12px;}
  .logo .p1{font-family:'Fraunces',serif;font-weight:700;font-size:24px;letter-spacing:.5px;color:var(--brand);}
  .logo .sub{font-size:10.5px;text-transform:uppercase;letter-spacing:2.5px;color:var(--brass);font-weight:600;}
  .clientline h1{font-family:var(--num);font-weight:600;font-size:25px;line-height:1.15;letter-spacing:-.8px;}
  .clientline h1 input{font:inherit;color:inherit;border:none;background:transparent;border-bottom:1px dashed transparent;max-width:340px;}
  .clientline h1 input:hover,.clientline h1 input:focus{border-bottom-color:var(--brass);outline:none;}
  .clientline{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
  body.is-home .clientline{display:none;}   /* elenco clienti: nessun cliente aperto */
  body.is-home .cli{display:none!important;}  /* e nemmeno i comandi che agiscono sul cliente aperto */
  .clientline .period{color:var(--ink2);font-size:13px;margin-top:2px;width:100%;}
  .namepen{border:1.5px solid var(--line);background:#fff;border-radius:8px;padding:5px 9px;font-size:13px;line-height:1;cursor:pointer;color:var(--ink2);}
  .namepen:hover{border-color:var(--brass);color:var(--brass);}
  .btn.ghost.ico{padding:8px 11px;font-size:15px;line-height:1;min-width:38px;text-align:center;}
  .topbtns{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
  .btn{background:var(--brand);color:#fff;border:none;border-radius:9px;padding:9px 15px;font-weight:600;font-size:13.5px;cursor:pointer;font-family:inherit;transition:background .15s;}
  .btn:hover{background:var(--brand-dk)}
  .btn.ghost{background:transparent;color:var(--brand);border:1.5px solid var(--brand);}
  .btn.ghost:hover{background:#ECEAE6}
  .btn.small{padding:5px 11px;font-size:12.5px;border-radius:7px;}
  input[type=file]{display:none}
  .clientsel{border:1.5px solid var(--brand);border-radius:9px;padding:8px 10px;font-family:inherit;font-size:13.5px;font-weight:600;color:var(--brand);background:#fff;max-width:210px;}

  /* layout con barra laterale */
  .app{display:flex;min-height:100vh;align-items:stretch;}
  .side{width:224px;flex-shrink:0;background:var(--scuro);border-right:1px solid #1C1C1C;padding:22px 12px 14px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto;}
  .side .logo{flex-direction:column;align-items:flex-start;gap:2px;margin:0 10px 18px;display:flex;}
  .side .logo .p1{color:#FFFFFF;font-size:21px;}
  .side .logo .sub{color:var(--brass);}
  .main{flex:1;min-width:0;}
  #nav{display:flex;flex-direction:column;gap:2px;}
  #nav button{background:none;border:none;font-family:inherit;font-size:14px;font-weight:500;color:#D8D6D2;
    text-align:left;padding:9px 12px;cursor:pointer;border-left:3px solid transparent;border-radius:8px;transition:all .12s;line-height:1.35;}
  #nav button:hover{background:var(--scuro-2);color:#fff;}
  #nav button.active{background:var(--scuro-2);color:#fff;font-weight:700;border-left-color:var(--brass);border-radius:0 8px 8px 0;}
  #nav .sep{height:1px;background:#3A3A3A;margin:8px 8px;}
  #nav .grp{font-size:10.5px;letter-spacing:1.6px;text-transform:uppercase;color:#8C8A85;font-weight:700;padding:14px 12px 4px;}
  .side-foot{margin-top:auto;padding:12px 10px 0;border-top:1px solid #3A3A3A;}
  .side-foot .ver{color:#8C8A85;font-size:11px;display:block;margin-bottom:3px;}
  .side-foot .ver b{color:var(--brass);font-family:var(--num);font-weight:600;letter-spacing:.3px;}
  .side-foot .savestate{color:#8C8A85;font-size:11px;line-height:1.4;display:block;}
  @media(max-width:900px){
    .app{flex-direction:column;}
    .side{width:100%;height:auto;position:static;flex-direction:column;padding:12px 14px;border-right:none;border-bottom:1px solid var(--line);}
    #nav .grp{display:none;}
    #nav{flex-direction:row;flex-wrap:wrap;gap:2px;}
    #nav button{border-left:none;border-bottom:3px solid transparent;border-radius:8px 8px 0 0;padding:8px 11px;}
    #nav button.active{border-left:none;border-bottom-color:var(--brass);}
    #nav .sep{display:none;}
    .side-foot{display:none;}
  }
  @media print{ .side{display:none!important;} }

  .alerts{display:flex;flex-direction:column;gap:8px;margin-bottom:20px;}
  .alert{border-radius:10px;padding:10px 14px;font-size:13.5px;display:flex;gap:10px;align-items:flex-start;border:1px solid transparent;}
  .alert b{font-weight:600}
  .alert.warn{background:var(--warn-bg);border-color:#EAD9A6;color:#6b5410;}
  .alert.bad{background:var(--bad-bg);border-color:#EAC7C2;color:#7c261c;}
  .alert.info{background:#ECEAE6;border-color:#D6D3CD;color:#3A3F44;}

  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px;}
  .kpi{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px 17px 14px;}
  .kpi .lbl{font-size:10.5px;text-transform:uppercase;letter-spacing:1.5px;color:var(--ink2);font-weight:600;margin-bottom:7px;}
  .kpi .val{font-family:var(--num);font-size:25px;font-weight:600;letter-spacing:-.5px;}
  .kpi .val.neg{color:var(--bad)} .kpi .val.pos{color:var(--ok)}
  .kpi .note{font-size:12px;color:var(--ink2);margin-top:5px;}
  .kpi.highlight{background:var(--brand);border-color:var(--brand);color:#fff;}
  .kpi.highlight .lbl{color:#B5B2AC} .kpi.highlight .val{color:var(--brass)} .kpi.highlight .note{color:#B5B2AC}

  section{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:20px 22px;margin-bottom:20px;}
  section h2{font-family:var(--num);font-weight:600;font-size:17.5px;margin-bottom:3px;letter-spacing:-.4px;}
  section .sub{color:var(--ink2);font-size:13px;margin-bottom:16px;}
  .sechead{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;}

  /* gauges */
  .strip{margin-bottom:30px;} .strip:last-child{margin-bottom:0}
  .strip .head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:0;flex-wrap:wrap;gap:4px;}
  .strip .name{font-weight:600;font-size:15px;}
  .strip .name small{color:var(--ink2);font-weight:400;font-size:12.5px;margin-left:8px;}
  .strip .name .pc{font-family:var(--num);font-size:16px;font-weight:700;margin-left:10px;}
  .strip .reading{font-family:var(--num);font-size:13px;font-weight:400;}
  .strip .reading .money{color:var(--ink2);}
  /* barra piena da sinistra: verde fino all'obiettivo, colore della zona per l'eccedenza */
  .devbar{position:relative;height:14px;margin-top:7px;}
  .devbar .zones{position:absolute;inset:0 0 auto 0;display:flex;height:14px;border-radius:3px;overflow:hidden;}
  .devbar .zones div{height:100%}
  .devbar .z-ok{flex:1;background:var(--ok-bg);} .devbar .z-warn{background:var(--warn-bg);}
  .devbar .z-hot{background:var(--hot-bg);}      .devbar .z-bad{flex:1;background:var(--bad-bg);}
  .devbar .fill{position:absolute;top:0;height:14px;z-index:2;transition:left .4s,width .4s;min-width:2px;}
  .devbar .fill.verde{left:0;background:var(--ok);border-radius:3px 0 0 3px;}
  .devbar .fill.extra{border-radius:0 3px 3px 0;}
  .devbar .fill.oltre{border-radius:0;box-shadow:inset -3px 0 0 #fff;}
  .devbar .obj{position:absolute;left:50%;top:-4px;width:2px;height:22px;background:var(--ink);transform:translateX(-50%);z-index:4;}
  .devbar .obj .pill{position:absolute;left:50%;top:11px;transform:translate(-50%,-50%);
    background:var(--ink);color:#fff;border-radius:999px;padding:0 7px;font-family:var(--num);font-size:10px;font-weight:700;white-space:nowrap;line-height:1.6;
    box-shadow:0 0 0 2px #fff;}
  .devbar .val{position:absolute;top:0;line-height:14px;font-family:var(--num);font-size:11px;font-weight:700;white-space:nowrap;z-index:3;}
  .devbar .val.dx{transform:translateX(8px);}
  .devbar .val.sx{transform:translateX(8px);}
  .devbar .val.dentro.dx{transform:translateX(calc(-100% - 8px));color:#fff!important;}
  .devbar .val.dentro.sx{transform:translateX(calc(-100% - 8px));color:#fff!important;}
  .verdict{display:inline-block;border-radius:6px;padding:1px 8px;font-size:11px;font-weight:600;margin-left:8px;vertical-align:1px;white-space:nowrap;}
  .v-ok{background:var(--ok-bg);color:var(--ok)} .v-warn{background:var(--warn-bg);color:#8a6a0c}
  .v-hot{background:var(--hot-bg);color:var(--hot)} .v-bad{background:var(--bad-bg);color:var(--bad)}

  .chartbox{position:relative;height:300px;}
  .chartbox.short{height:240px}

  .bu{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .bucard{border:1px solid var(--line);border-radius:12px;padding:15px 17px;border-top:3px solid var(--line);}
  .bucard.food{border-top-color:var(--food);} .bucard.food h3{color:var(--food-dk);}
  .bucard.bev{border-top-color:var(--bev);}  .bucard.bev h3{color:var(--bev-dk);}
  .icard.food .lbl{color:var(--food-dk);} .icard.bev .lbl{color:var(--bev-dk);}
  .bucard h3{font-family:var(--num);font-size:15px;font-weight:600;margin-bottom:2px;letter-spacing:-.3px;}
  .bucard .share{font-size:12.5px;color:var(--ink2);margin-bottom:10px;}
  .buline{display:flex;justify-content:space-between;align-items:baseline;padding:6px 0;border-top:1px dashed var(--line);font-size:13.5px;gap:8px;flex-wrap:wrap;}
  .buline .v{font-family:var(--num);font-weight:600;font-size:13px;}
  .splitbar{display:flex;height:12px;border-radius:6px;overflow:hidden;margin:6px 0 16px;}
  .splitbar .f{background:var(--food)} .splitbar .bv{background:var(--bev)}
  .legend{display:flex;gap:16px;font-size:12.5px;color:var(--ink2);margin-bottom:4px;}
  .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;vertical-align:-1px;}

  /* entry tables */
  .tblwrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;}
  table.entry{border-collapse:collapse;width:100%;font-size:12.5px;min-width:900px;}
  table.entry th,table.entry td{border-bottom:1px solid var(--line);border-right:1px solid #F0EEE8;padding:0;}
  table.entry th{background:#FAF9F6;font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--ink2);padding:8px 8px;text-align:right;white-space:nowrap;}
  table.entry th:first-child{text-align:left}
  table.entry td.lbl{padding:6px 10px;font-weight:500;white-space:nowrap;background:#fff;position:sticky;left:0;min-width:180px;border-right:1px solid var(--line);}
  table.entry td.lbl .role{display:block;font-size:11px;color:var(--ink2);font-weight:400;}
  table.entry td.lbl input{border:none;background:transparent;font:inherit;width:100%;padding:0;}
  table.entry td.lbl input:focus{outline:none;border-bottom:1px dashed var(--brass);}
  table.entry input.num{width:86px;border:none;background:transparent;font-family:var(--num);font-size:12.5px;text-align:right;padding:7px 8px;color:var(--ink);}
  table.entry input.num:focus{outline:2px solid var(--brass);outline-offset:-2px;border-radius:4px;background:#FFFDF6;}
  table.entry input.num.filled{background:#F4F8F5;}
  table.entry td.tot,table.entry th.tot{font-family:var(--num);font-weight:600;text-align:right;padding:7px 10px;background:#FAF9F6;white-space:nowrap;}
  table.entry tr.grouph td{background:#E2E0DB;color:var(--brand-dk);font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:1px;padding:7px 10px;position:static;border-top:2px solid var(--brand);}
  /* personale: nome, ruolo e reparto su una riga sola */
  table.entry tr.prow td.lbl{padding:2px 10px;min-width:300px;}
  #sgTable td.lbl{min-width:265px;padding:3px 10px;}  /* le voci di spesa hanno nomi lunghi */
  #sgTable input.num{padding:5px 8px;}
  #sgTable td.tot{padding:5px 10px;}
  #sgTable td:last-child{white-space:nowrap;padding:0 4px;}  /* i due bottoni restano affiancati: la riga non raddoppia */
  table.entry tr.prow input.num{padding:4px 8px;}
  .pline{display:flex;align-items:center;gap:6px;}
  .pline input.pnome{flex:1 1 auto;min-width:90px;font-size:13px;}
  .pline input.pruolo{flex:0 1 118px;font-size:11px;color:var(--ink2);border-bottom:1px dotted var(--line)!important;}
  .pline select.prep{flex:0 0 auto;font-size:10.5px;border:1px solid var(--line);border-radius:5px;color:var(--ink2);background:#fff;padding:1px 2px;}
  table.entry tr.sumrow td{background:#F3F1EB;font-weight:600;}
  /* i due totali di blocco (ricavi e materia prima) staccano dalle altre righe di riepilogo */
  table.entry tr.sumrow.strong td{background:#E6E3DA;font-weight:700;border-top:1px solid var(--brand);}
  table.entry tr.sumrow.strong td.lbl{background:#E6E3DA;letter-spacing:.3px;}
  /* riga vuota: separa la fine di un blocco dall'intestazione del successivo */
  table.entry tr.spacer td{height:12px;padding:0;background:#fff;border-bottom:none;border-right:none;}
  /* righe merchandising: sfondo rosso chiaro, riga bassa, etichetta su una sola riga */
  table.entry tr.mkrow td{background:var(--porpora-bg);}
  table.entry tr.mkrow td.lbl{background:var(--porpora-bg);font-size:12px;padding:2px 10px;}
  table.entry tr.mkrow input.num{padding:4px 8px;background:transparent;}
  table.entry tr.mkrow input.num.filled{background:#EDD6DE;}
  table.entry tr.mkrow input.num:focus{background:#FFFDF6;}
  table.entry td.lbl .roleinl{font-size:11px;color:var(--ink2);font-weight:400;white-space:nowrap;}
  table.entry tr.sumrow td.lbl{background:#F3F1EB}
  .rowdel{border:none;background:none;color:#C9C4B8;cursor:pointer;font-size:14px;padding:2px 6px;}
  .rowdel:hover{color:var(--bad)}
  .tbltools{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;align-items:center;}
  .livebar{display:flex;gap:18px;flex-wrap:wrap;margin-bottom:14px;}
  .live{background:#FAF9F6;border:1px solid var(--line);border-radius:10px;padding:8px 14px;font-size:12.5px;color:var(--ink2);}
  .live b{font-family:var(--num);color:var(--ink);font-size:14px;display:block;}
  .live select,.live input[type=number]{font-family:'Inter',sans-serif;font-size:12.5px;border:1px solid var(--line);border-radius:6px;padding:3px 6px;background:#fff;color:var(--ink);}
  .live input[type=number]{width:56px;font-family:var(--num);text-align:right;}
  .live input[type=number]:disabled{opacity:.45;}
  .live .eff{display:block;font-size:11.5px;color:var(--ink2);margin-top:3px;}
  .live b.neg{color:var(--bad)} .live b.pos{color:var(--ok)}

  .params{display:flex;gap:14px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--ink2);}
  .params label{display:flex;align-items:center;gap:6px;}
  .params label.calc input{background:#F1EFEB;color:var(--brand);font-weight:700;cursor:default;}
  .params .formula{font-family:var(--num);font-size:11px;color:var(--ink2);}
  .params input{width:58px;border:1px solid var(--line);border-radius:6px;padding:4px 6px;font-family:var(--num);font-size:13px;text-align:right;}

  .icx{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px;}
  .icard{border:1px solid var(--line);border-radius:12px;padding:13px 15px;}
  .icard .lbl{font-size:10.5px;text-transform:uppercase;letter-spacing:1.3px;color:var(--ink2);font-weight:600;}
  .icard .val{font-family:var(--num);font-size:19px;font-weight:600;margin-top:3px;}
  .icard .note{font-size:11.5px;color:var(--ink2);margin-top:2px;}
  .mpsgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
  .mpsin{width:62px;border:1px solid var(--line);border-radius:6px;padding:3px 6px;font-family:var(--num);font-size:12.5px;text-align:right;background:#fff;}
  @media(max-width:900px){ .mpsgrid{grid-template-columns:1fr} }

  .chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px;align-items:center;}
  .chips .cl{font-size:11px;text-transform:uppercase;letter-spacing:1.4px;color:var(--ink2);font-weight:600;margin-right:4px;}
  .chip{border:1px solid var(--line);background:#fff;border-radius:999px;padding:5px 13px;font-size:12.5px;font-weight:600;color:var(--ink2);cursor:pointer;font-family:inherit;transition:all .12s;}
  .chip:hover{border-color:var(--brand);color:var(--brand);}
  .chip.active{background:var(--brand);border-color:var(--brand);color:#fff;}
  .chip:disabled{opacity:.35;cursor:default;}
  .chip:disabled:hover{border-color:var(--line);color:var(--ink2);}

  .importbox{border:1.5px dashed var(--brass);background:#FDFAF3;border-radius:12px;padding:13px 16px;margin-bottom:16px;display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;font-size:13.5px;}
  .importbox b{color:var(--brand)}
  .importbox[hidden]{display:none;}
  .importbox .msg{font-size:12.5px;color:var(--ink2);width:100%;}
  .btn.small.tpl{background:#fff;color:var(--brass);border:1.5px solid var(--brass);}
  .btn.small.tpl:hover{background:var(--brass);color:#fff;}
  .splitgrid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;}
  .splitgrid .sm{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--ink2);}
  .splitgrid input{width:52px;border:1px solid var(--line);border-radius:6px;padding:4px 5px;font-family:var(--num);font-size:12px;text-align:right;background:#fff;}
  @media(max-width:900px){ .splitgrid{grid-template-columns:repeat(3,1fr)} }

  /* visore PDF */
  .pdfviewer{border:1px solid var(--line);border-radius:12px;margin-bottom:16px;overflow:hidden;background:#FAF9F6;}
  .pdfbar{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:#fff;}
  .pdfbar .pdfname{font-weight:600;font-size:13px;color:var(--brand);margin-right:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:50%;}
  .pdfbar .pinfo{font-family:var(--num);font-size:12.5px;color:var(--ink2);}
