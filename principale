/* una famiglia di colore per macrocategoria, una sfumatura per ogni voce.
   Si evitano di proposito i colori che nell'app vogliono già dire qualcosa:
   verde/giallo/arancio/rosso = stato del dato, viola e azzurro = Food e Beverage. */
const SG_TINTE={
  'Costi Gestionali Struttura':      ['#16385C','#A7C4E0'],   // blu
  'Consulenze esterne':              ['#14484F','#9CC3C6'],   // petrolio
  'Banche - Tasse - Imposte':        ['#343D4B','#B6BECA'],   // ardesia
  'Altri costi / Servizi':           ['#5E4526','#CFB894'],   // bruno
  'Formazione & Pubblicità generica':['#5C3A52','#C9A9BE'],   // malva
};
/* sotto lo 0,05% la percentuale arrotondata direbbe "0%" o "-0%": meglio dirlo a parole */
const quotaTxt = q => (isFinite(q) && Math.abs(q)<0.0005) ? '<0,1%' : fmtP(q);
const mix=(a,b,t)=>{
  const h=s=>[1,3,5].map(i=>parseInt(s.substr(i,2),16));
  const [r1,g1,b1]=h(a),[r2,g2,b2]=h(b);
  const c=(x,y)=>Math.round(x+(y-x)*t).toString(16).padStart(2,'0');
  return '#'+c(r1,r2)+c(g1,g2)+c(b1,b2);
};
function sgChart(){
  killChart('sg');
  const ric=compute().ricavi;
  /* voci con un importo, raggruppate e ordinate per peso: prima i gruppi grandi, poi le voci grandi */
  const perGruppo={};
  S.sg.forEach(c=>{
    const t=c.m.reduce((a,v)=>a+num(v),0);
    if(Math.abs(t)<0.5) return;
    (perGruppo[c.gruppo]=perGruppo[c.gruppo]||[]).push({nome:c.nome, tot:t});
  });
  const gruppi=Object.keys(perGruppo)
    .map(g=>({g, tot:perGruppo[g].reduce((a,x)=>a+x.tot,0), voci:perGruppo[g].sort((a,b)=>b.tot-a.tot)}))
    .sort((a,b)=>b.tot-a.tot);
  const labels=[], data=[], colori=[], legenda=[];
  gruppi.forEach(({g,tot,voci})=>{
    const tinta = SG_TINTE[g] || (g===SG_MERCH ? ['#5E2338','#C79DAE'] : ['#4A4A4A','#C4C4C4']);
    const righe=[];
    voci.forEach((v,i)=>{
      const col=mix(tinta[0],tinta[1], voci.length>1 ? i/(voci.length-1)*0.82 : 0);
      labels.push(v.nome); data.push(+v.tot.toFixed(2)); colori.push(col);
      righe.push(`<li><i style="background:${col}"></i><span class="n">${v.nome}</span><span class="v">${fmtE(v.tot)}${ric>0?' · '+quotaTxt(v.tot/ric):''}</span></li>`);
    });
    legenda.push(`<div class="lg"><div class="lgh" style="border-color:${tinta[0]};color:${tinta[0]}">${g}
      <span>${fmtE(tot)}${ric>0?' · '+quotaTxt(tot/ric):''}</span></div><ul>${righe.join('')}</ul></div>`);
  });
  const el=document.getElementById('sgLegend');
  if(el) el.innerHTML=legenda.join('');
  charts.sg=new Chart(document.getElementById('chSg'),{
    type:'doughnut',
    data:{labels,datasets:[{data,backgroundColor:colori,borderWidth:1.5,borderColor:'#fff'}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:'58%',
      plugins:{legend:{display:false},
        tooltip:{callbacks:{label:c=>` ${c.label}: ${fmtE(c.raw)}${ric>0?' · '+quotaTxt(c.raw/ric):''}`}}}}
  });
}

