async function ensureSeedBarcollo(){
  CLIENTS.deleted=CLIENTS.deleted||[];
  if(CLIENTS.deleted.includes(SEED_BARCOLLO_ID)) return false;            // eliminato apposta: non lo ripropongo
  if(CLIENTS.list.find(c=>c.id===SEED_BARCOLLO_ID)) return false;          // già presente
  const existing=await stGet('planetone-fb:'+SEED_BARCOLLO_ID);
  if(!existing) await stSet('planetone-fb:'+SEED_BARCOLLO_ID, JSON.stringify(SEED_BARCOLLO));
  CLIENTS.list.push({id:SEED_BARCOLLO_ID, nome:'Al Barcollo', updated:Date.now()});
  await stSet('planetone-clients', JSON.stringify(CLIENTS));
  return true;
}

