  const cur=compute();
  const rRatio=(cur.ricaviFood+cur.ricaviBev)>0?cur.ricaviFood/(cur.ricaviFood+cur.ricaviBev):.5;
  const mRatio=(cur.mpFood+cur.mpBev)>0?cur.mpFood/(cur.mpFood+cur.mpBev):.5;
  const ruM=zeros(), sgM=zeros();
  let applied=0, hasRU=false, hasSG=false, splitR=false, splitM=false;
  res.mesi.forEach(row=>{
    const i=MESI.findIndex(M=>norm(M)===norm(row.mese)); if(i<0) return;
