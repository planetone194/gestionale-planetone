async function smartImport(file){
  const msg=document.getElementById('ceImportMsg');
  const say=(t,err)=>{ toast(t,err); if(msg) msg.textContent=(err?'⚠️ ':'')+t; };
  const isPdf=/\.pdf$/i.test(file.name)||file.type==='application/pdf';
  try{
    if(isPdf){
      const master=await file.arrayBuffer();
      gotoPage('ce');
      showPdf(master.slice(0), file.name);
      say('Leggo il PDF…');
      let localErr=null;
      try{
        const lines=await pdfToLines(master.slice(0));
        const r=await parsePdfCE(lines, file.name);
        if(r.ok){
          scope='ytd'; renderAll(); saveState();
          say('✓ '+r.msg+' Controlla i numeri con l\'anteprima qui sotto.');
          return;
        }
        localErr=r.msg;
      }catch(e){ localErr=e.message; }
      say('Lettura diretta non riuscita ('+localErr+'): provo l\'analisi AI…');
      const b64=await fileToB64(file);
      /* passo 1: l'AI trascrive le righe contabili, poi il parser locale le divide voce per voce */
      try{
        const tr=await aiCall([
          {type:'document',source:{type:'base64',media_type:'application/pdf',data:b64}},
          {type:'text',text:'Trascrivi fedelmente OGNI riga contabile del documento, una per riga, nel formato: CODICE DESCRIZIONE IMPORTO (importo in formato italiano, es. 1.234,56). Come prima riga scrivi il periodo se presente (es. 01/01/26 - 31/01/26). Nessun altro testo, nessun totale se non presente nel documento.'}
        ]);
        const lines=tr.split(/\n+/).map(l=>l.replace(/```/g,'').trim()).filter(Boolean);
        const r2=await parsePdfCE(lines, file.name);
        if(r2.ok){
          scope='ytd'; renderAll(); saveState();
          say('✓ (via AI, dettaglio voce per voce) '+r2.msg+' Controlla i numeri con l\'anteprima qui sotto.');
          return;
        }
      }catch(eTr){ /* si passa al ripiego aggregato */ }
      /* passo 2 (ultimo ripiego): estrazione aggregata */
      try{
        const res=await aiExtract([
          {type:'document',source:{type:'base64',media_type:'application/pdf',data:b64}},
          {type:'text',text:AI_PROMPT}
        ]);
        say('✓ '+applyAI(res, file.name)+' Nota: da questo documento ho potuto estrarre solo i totali (spese generali in voce unica); per il dettaglio voce per voce usa "Incolla dati" con il testo del documento.');
      }catch(errAI){
        throw new Error('lettura diretta: '+localErr+' · analisi AI: '+(errAI.message||'non disponibile'));
      }
      return;
    }
    say('Lettura di '+file.name+'…');
    const wb=XLSX.read(await file.arrayBuffer(),{type:'array',cellDates:false});
    const isP1=wb.SheetNames.some(n=>norm(n).includes('sintesi bilanci')&&!norm(n).includes('full'));
    if(isP1){
      await importPlanetOne(wb, file.name);
      renderAll();
      say('✓ Bilancio Planet One importato: conto economico, personale, spese e costi nascosti.');
      return;
    }
    const res=genericCE(wb);
    if(res.ok){ scope='ytd'; renderAll(); saveState(); say('✓ '+res.msg); return; }
    /* formato Excel non riconosciuto → analisi AI sul contenuto */
    say('Formato non standard: analisi AI in corso…');
    const csv=wb.SheetNames.slice(0,4).map(n=>'--- FOGLIO: '+n+' ---\n'+
      XLSX.utils.sheet_to_csv(wb.Sheets[n]).split('\n').slice(0,100).join('\n')).join('\n\n');
    const ai=await aiExtract([{type:'text',text:AI_PROMPT+'\n\nDOCUMENTO (estratto CSV):\n'+csv}]);
    say('✓ '+applyAI(ai, file.name));
  }catch(err){
    say('Impossibile importare '+file.name+': '+err.message, true);
  }
}
