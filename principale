/* ---------- import paghe: nomi + importi, abbinati alle persone ---------- */
function nameTokens(x){ return norm(x).split(/[^a-zà-ù]+/).filter(t=>t.length>2); }
/* distanza di edit: serve a riconoscere gli errori di battitura nei cognomi (Alazani / Alazami) */
function lev(a,b){
  const m=a.length, n=b.length; if(!m||!n) return Math.max(m,n);
  let pr=Array.from({length:n+1},(_,j)=>j), cu=new Array(n+1);
  for(let i=1;i<=m;i++){ cu[0]=i;
    for(let j=1;j<=n;j++) cu[j]=Math.min(pr[j]+1, cu[j-1]+1, pr[j-1]+(a[i-1]===b[j-1]?0:1));
    [pr,cu]=[cu,pr];
  }
  return pr[n];
}
function matchPerson(label){
  const lt=nameTokens(label); if(!lt.length) return null;
  /* due parole si somigliano se sono uguali o differiscono per un refuso, MAI per semplice prefisso:
     "Mari" e "Mariantonietta" sono due persone diverse e non vanno fuse */
  const vicino=(a,b)=> a===b || (a.length>=5 && b.length>=5 && Math.abs(a.length-b.length)<=2 && lev(a,b)<=2);
  let best=null,score=0;
  S.ru.forEach(p=>{
    const pt=nameTokens(p.nome); if(!pt.length) return;
    const sh=lt.filter(t=>pt.some(q=>vicino(q,t))).length;
    if(sh>score){ score=sh; best=p; }
  });
  if(!best) return null;
  /* se entrambi i nomi hanno nome e cognome, devono coincidere tutti e due */
  const minimo = (lt.length>=2 && nameTokens(best.nome).length>=2) ? 2 : 1;
  return score>=minimo ? best : null;
}
