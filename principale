function sgPartSums(idx){
  const parts={rent:0, amm:0, fin:0, tax:0, oh:0};
  S.sg.forEach(c=>{
    const n=norm(c.nome);
    const tot=idx.reduce((a,i)=>a+num(c.m[i]),0);
    if(!tot) return;
    if(/affitt|locazion/.test(n)) parts.rent+=tot;
    else if(/ammortament/.test(n)) parts.amm+=tot;
    else if(/interessi|quota capitale|oneri finanziari/.test(n)) parts.fin+=tot;
    else if(/tribut|imposta|imposte|imu|imis|rifiuti|bollo|cciaa/.test(n)) parts.tax+=tot;
    else parts.oh+=tot;
  });
  return parts;
}
