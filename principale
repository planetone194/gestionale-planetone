function uiModal(msg, opt){
  opt=opt||{};
  return new Promise(res=>{
    const md=document.getElementById('modal'), inp=document.getElementById('mInput'), area=document.getElementById('mArea');
    document.getElementById('mMsg').textContent=msg;
    inp.hidden=!opt.input; area.hidden=!opt.area;
    inp.value=opt.def||''; area.value='';
    md.hidden=false;
    setTimeout(()=>{ if(opt.input) inp.focus(); if(opt.area) area.focus(); },30);
    const ok=document.getElementById('mOk'), ca=document.getElementById('mCancel');
    const done=v=>{ md.hidden=true; ok.removeEventListener('click',okf); ca.removeEventListener('click',caf); inp.removeEventListener('keydown',kf); res(v); };
    const okf=()=>done(opt.input?inp.value.trim():(opt.area?area.value:true));
    const caf=()=>done(opt.input||opt.area?null:false);
    const kf=e=>{ if(e.key==='Enter') okf(); if(e.key==='Escape') caf(); };
    ok.addEventListener('click',okf); ca.addEventListener('click',caf); inp.addEventListener('keydown',kf);
  });
}
