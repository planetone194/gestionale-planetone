/* ---- caricamento del file spese generali (template o foglio con i mesi in colonna) ---- */
async function importSGFile(file){
  const msg=document.getElementById('sgImportMsg');
  const say=(t,err)=>{ toast(t,err); if(msg) msg.textContent=(err?'⚠️ ':'')+t; };
  try{
    say('Lettura di '+file.name+'…');
    const wb=XLSX.read(await file.arrayBuffer(),{type:'array'});
    for(const n of wb.SheetNames){
      const g=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:null});
      if(!g.length) continue;
      /* riga di intestazione: quella con almeno 3 mesi */
      let hr=-1; const mcols={};
      for(let r=0;r<Math.min(g.length,15);r++){
        const found={};
        (g[r]||[]).forEach((v,c)=>{ const mi=monthIdx(v); if(mi>=0&&found[mi]==null) found[mi]=c; });
        if(Object.keys(found).length>=3){ hr=r; Object.assign(mcols,found); break; }
      }
      if(hr<0) continue;
      const mset=new Set(Object.values(mcols).map(Number));
      /* colonne testo: la prima è il gruppo, la seconda la voce (se c'è una sola colonna, è la voce) */
      const head=(g[hr]||[]);
      let cGruppo=-1, cVoce=-1;
      head.forEach((v,c)=>{ if(mset.has(c)) return; const t=norm(v);
        if(cGruppo<0 && /gruppo|categoria|famiglia/.test(t)) cGruppo=c;
        else if(cVoce<0 && /voce|descrizione|conto|costo/.test(t)) cVoce=c; });
      if(cVoce<0){ const testo=[]; for(let c=0;c<Math.max(head.length,4);c++) if(!mset.has(c)) testo.push(c);
        if(testo.length>=2){ if(cGruppo<0) cGruppo=testo[0]; cVoce=testo[1]; } else cVoce=testo[0]!=null?testo[0]:0; }
      let agg=0, nuove=0, tot=0; const mesiTocc=new Set();
      for(let r=hr+1;r<g.length;r++){
        const row=g[r]||[];
        const voce=String(row[cVoce]==null?'':row[cVoce]).trim();
        if(!voce) continue;
        if(/^total/i.test(norm(voce))) continue;
        const gruppo=(cGruppo>=0 && row[cGruppo]) ? String(row[cGruppo]).trim() : 'Altro';
        const vals={}; let haVal=false;
        Object.entries(mcols).forEach(([mi,c])=>{ const v=cellNum(row[c]); if(v!==null&&v!==undefined&&v!==0){ vals[mi]=v; haVal=true; } });
        if(!haVal) continue;
        let c0=S.sg.find(x=>norm(x.nome)===norm(voce));
        if(!c0){ c0={id:newId(), gruppo, nome:voce, m:zeros()}; S.sg.push(c0); nuove++; }
        else { agg++; if(gruppo && gruppo!=='Altro') c0.gruppo=gruppo; }
        Object.entries(vals).forEach(([mi,v])=>{ c0.m[+mi]=+num(v).toFixed(2); tot+=num(v); mesiTocc.add(+mi); });
      }
      if(agg+nuove===0) continue;
      renderSG(); renderDash(); saveState();
      const mm=[...mesiTocc].sort((a,b)=>a-b);
      say(`✓ Spese generali caricate: ${agg} voci aggiornate, ${nuove} nuove, su ${mm.length} mesi (${mm.length?MESI[mm[0]].slice(0,3)+'–'+MESI[mm[mm.length-1]].slice(0,3):''}) · ${fmtE(tot)} di costi.`);
      return;
    }
    say('Non ho riconosciuto il foglio: servono una riga con i nomi dei mesi e una colonna con le voci di costo. Scarica il template e compilalo.', true);
  }catch(e){ say('Impossibile leggere '+file.name+': '+(e.message||'errore'), true); }
}

/* scrive un mese del conto economico senza buttare via il merchandising già inserito */
function ceSet(i,o){
  const p=S.ce[i]||{};
  S.ce[i]=Object.assign({rf:0,rb:0,ra:0,mf:0,mb:0,
    rfm:num(p.rfm), rbm:num(p.rbm), mfm:num(p.mfm), mbm:num(p.mbm)}, o);
}
function classifyCE(l){
  l=norm(l); if(!l) return null;
  const food=/\bfood\b|cucina/.test(l), bev=/bever|\bbar\b|bevande|bibite|caffetteria/.test(l);
  const merch=/merchandis|merch\b/.test(l);   // va valutato prima di "merci"
  if(/totale/.test(l)) return null; // i totali non si importano: si ricalcolano
  if(/ricav|corrispettiv|vendite|incass/.test(l)){
    if(merch){ if(bev) return 'rbm'; return 'rfm'; }
    if(food) return 'rf'; if(bev) return 'rb';
    if(/altri|divers/.test(l)) return 'ra';
    return 'rTot';
  }
  if(/materie prime|materia prima|acquist|merc[i]|consumi|cost of|food cost|beverage cost/.test(l)){
    if(merch){ if(bev) return 'mbm'; return 'mfm'; }
    if(food) return 'mf'; if(bev) return 'mb';
    return 'mTot';
  }
  return null;
}
function genericCE(wb){
  for(const n of wb.SheetNames){
    const g=XLSX.utils.sheet_to_json(wb.Sheets[n],{header:1,raw:true,defval:null});
    if(!g.length) continue;
    /* --- layout A: mesi in colonna (header di riga) --- */
    for(let r=0;r<Math.min(g.length,25);r++){
      const row=g[r]||[]; const mcols={}; let cnt=0;
      row.forEach((v,c)=>{ const mi=monthIdx(v); if(mi>=0 && mcols[mi]==null){ mcols[mi]=c; cnt++; } });
      if(cnt>=3){
        const acc={rf:zeros(),rb:zeros(),ra:zeros(),mf:zeros(),mb:zeros(),rTot:zeros(),mTot:zeros(),rfm:zeros(),rbm:zeros(),mfm:zeros(),mbm:zeros()};
        const seen={rf:0,rb:0,mf:0,mb:0,rTot:0,mTot:0,ra:0,rfm:0,rbm:0,mfm:0,mbm:0};
        for(let rr=r+1; rr<g.length; rr++){
          const label=(g[rr]||[]).find(v=>typeof v==='string'&&v.trim());
          const k=classifyCE(label); if(!k) continue;
          seen[k]++;
          Object.entries(mcols).forEach(([mi,c])=>{ acc[k][+mi]+=num((g[rr]||[])[c]); });
        }
        return applyCE(acc,seen,n);
      }
    }
    /* --- layout B: mesi in riga (prima colonna) --- */
    const mrows={}; let cnt=0;
    g.forEach((row,r)=>{ const mi=monthIdx((row||[])[0]); if(mi>=0&&mrows[mi]==null){ mrows[mi]=r; cnt++; } });
    if(cnt>=3){
      // le etichette voce stanno nella riga sopra il primo mese
      const firstR=Math.min(...Object.values(mrows));
      let headR=-1;
      for(let r=firstR-1;r>=0;r--){ if((g[r]||[]).some(v=>classifyCE(v))){ headR=r; break; } }
      if(headR>=0){
        const acc={rf:zeros(),rb:zeros(),ra:zeros(),mf:zeros(),mb:zeros(),rTot:zeros(),mTot:zeros(),rfm:zeros(),rbm:zeros(),mfm:zeros(),mbm:zeros()};
        const seen={rf:0,rb:0,mf:0,mb:0,rTot:0,mTot:0,ra:0,rfm:0,rbm:0,mfm:0,mbm:0};
        (g[headR]||[]).forEach((v,c)=>{
          const k=classifyCE(v); if(!k) return; seen[k]++;
          Object.entries(mrows).forEach(([mi,r])=>{ acc[k][+mi]+=num((g[r]||[])[c]); });
        });
        return applyCE(acc,seen,n);
      }
    }
  }
  return {ok:false, msg:'Non ho riconosciuto mesi e voci: servono le colonne (o righe) dei mesi e voci tipo "Ricavi food", "Materie prime beverage".'};
}
function applyCE(acc,seen,sheetName){
  const hasSplitR=seen.rf||seen.rb, hasSplitM=seen.mf||seen.mb;
  const notes=[];
  // ratio esistente per gli split mancanti
  const cur=compute();
  const rRatio = (cur.ricaviFood+cur.ricaviBev)>0 ? cur.ricaviFood/(cur.ricaviFood+cur.ricaviBev) : .5;
  const mRatio = (cur.mpFood+cur.mpBev)>0 ? cur.mpFood/(cur.mpFood+cur.mpBev) : .5;
  let applied=0;
  MESI.forEach((_,i)=>{
    const rRi=monthSplitR(i,rRatio), mRi=monthSplitR(i,mRatio);
    const rf = hasSplitR ? acc.rf[i] : acc.rTot[i]*rRi;
    const rb = hasSplitR ? acc.rb[i] : acc.rTot[i]*(1-rRi);
    const ra = acc.ra[i];
    const mf = hasSplitM ? acc.mf[i] : acc.mTot[i]*mRi;
    const mb = hasSplitM ? acc.mb[i] : acc.mTot[i]*(1-mRi);
    const rfm=acc.rfm[i], rbm=acc.rbm[i], mfm=acc.mfm[i], mbm=acc.mbm[i];
    if(rf||rb||ra||mf||mb||rfm||rbm||mfm||mbm){
      const prec=S.ce[i]||{};
      S.ce[i]={rf:+rf.toFixed(2), rb:+rb.toFixed(2), ra:+ra.toFixed(2), mf:+mf.toFixed(2), mb:+mb.toFixed(2),
        // il merchandising già inserito a mano non si perde se il file non lo riporta
        rfm:+( (seen.rfm?rfm:num(prec.rfm)) ).toFixed(2), rbm:+( (seen.rbm?rbm:num(prec.rbm)) ).toFixed(2),
        mfm:+( (seen.mfm?mfm:num(prec.mfm)) ).toFixed(2), mbm:+( (seen.mbm?mbm:num(prec.mbm)) ).toFixed(2)};
      applied++;
    }
  });
  if(!applied) return {ok:false, msg:'Voci riconosciute ma senza importi mensili.'};
  if(!hasSplitR) notes.push(`ricavi senza distinzione Food/Beverage: divisi ${fmtP(rRatio)} / ${fmtP(1-rRatio)}`);
  if(!hasSplitM) notes.push(`materia prima senza distinzione: divisa ${fmtP(mRatio)} / ${fmtP(1-mRatio)}`);
  return {ok:true, msg:`Letto il foglio "${sheetName}": ${applied} mesi compilati.${notes.length?' Nota: '+notes.join('; ')+'.':''}`};
}
